<Window x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.OverseerWarsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LaboratoireProgrammation.Project.ModernOverseerWars"
        Title="☢ OVERSEER WARS"
        Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" WindowStyle="None">
    <Window.Resources>
        <Style TargetType="Button" x:Key="GameButton">
            <Setter Property="Background"   Value="#1A1A30"/>
            <Setter Property="Foreground"   Value="#9999CC"/>
            <Setter Property="BorderBrush"  Value="#334"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="10,4"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="8"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="210"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Rectangle Fill="#111" Height="8"/>
            <Rectangle x:Name="TimerBar" HorizontalAlignment="Left" Height="8"
                       Width="1280" Fill="#41521F"/>
        </Grid>

        <Border Grid.Row="1" x:Name="TopBar" Background="#0D0D20" BorderBrush="#223" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="☢ OVERSEER WARS"
                           Foreground="#BBBBDD" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ActivePlayerLabel" Text="Player 1's Turn"
                               FontSize="13" FontWeight="Bold" Margin="0,0,16,0"/>
                    <TextBlock x:Name="ElecText"  Text="⚡ 20"  Foreground="#AAAACC" FontSize="12" Margin="8,0"/>
                    <TextBlock x:Name="WaterText" Text="💧 20"  Foreground="#AAAACC" FontSize="12" Margin="8,0"/>
                    <TextBlock x:Name="FoodText"  Text="🍅 20"  Foreground="#AAAACC" FontSize="12" Margin="8,0"/>
                    <TextBlock x:Name="ApText"    Text="PA: 5/5" Foreground="#CCAA44" FontSize="12" Margin="8,0"/>
                    <TextBlock x:Name="TurnText"  Text="Turn 1" Foreground="#888" FontSize="12" Margin="8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="EndTurnButton" Content="End Turn ▶"
                            Style="{StaticResource GameButton}"
                            Background="#1A2A1A" Foreground="#66BB66" BorderBrush="#446644"
                            Click="OnEndTurn" Margin="0,0,8,0"/>
                    <Button x:Name="PhaseIndicator" Content="🏠 VAULT"
                            Style="{StaticResource GameButton}" Click="OnToggleView"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.2">
                <local:OutlinedTextBlock x:Name="BgUsernameText" Text="OVERSEER"/>
            </Viewbox>

            <Border x:Name="MapBorder" Margin="20" BorderBrush="#223" BorderThickness="2" CornerRadius="8" Background="#0C0C1E" ClipToBounds="True">
                <ScrollViewer x:Name="MapView" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" ClipToBounds="True" MouseWheel="MapView_MouseWheel">
                    <Canvas x:Name="MapCanvas" Width="900" Height="540" ClipToBounds="True" Background="Transparent"
                            MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                            MouseMove="MapCanvas_MouseMove"
                            MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1" />
                        </Canvas.LayoutTransform>
                    </Canvas>
                </ScrollViewer>
            </Border>

            <Grid x:Name="VaultView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8">
                    <TextBlock Text="🏠 YOUR VAULT — ROOMS" Foreground="#8888BB"
                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="BuildRoomButton" Content="+ Build Room"
                             Style="{StaticResource GameButton}" Margin="16,0,0,0"
                             Click="OnBuildRoom"/>
                </StackPanel>
                <ScrollViewer x:Name="RoomsScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="OnRoomsPreviewMouseWheel">
                    <StackPanel x:Name="RoomsPanel" Orientation="Horizontal" Margin="12,0,12,8"/>
                </ScrollViewer>
            </Grid>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="220" Margin="0,8,8,0">
                <Border x:Name="InfoPanel"
                        Background="#0D0D20" BorderBrush="#223" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="InfoTitle" Text="Select a tile or dweller"
                                   Foreground="#9999BB" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="InfoBody"  Text="" Foreground="#7777AA" FontSize="10" TextWrapping="Wrap"/>
                        <Button x:Name="DeployButton"  Content="🚀 Deploy here"  Margin="0,8,0,0"
                                Style="{StaticResource GameButton}" Click="OnDeployDweller"/>
                    </StackPanel>
                </Border>

                <Border x:Name="WarningPanel" Margin="0,8,0,0"
                        Background="#CC3333" BorderBrush="#FF5555" BorderThickness="1.5" CornerRadius="6" Padding="10"
                        Visibility="Collapsed">
                    <TextBlock x:Name="WarningText" Text="Warning" 
                               Foreground="White" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>

            <Canvas x:Name="PopupCanvas" IsHitTestVisible="False"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>
            <local:DeckPicker x:Name="DeckPickerControl" Grid.Column="0"/>
            
            <Border Grid.Column="1" Background="#0F0F25" BorderBrush="#223" BorderThickness="1,0,0,0" Padding="8"
                    AllowDrop="True" Drop="OnAssignmentSlotDrop" DragOver="OnAssignmentSlotDragOver">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="🛠 EQUIP DWELLER" Foreground="#8888BB" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                    
                    <Grid Grid.Row="1" x:Name="AssignmentSlotContainer" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border BorderBrush="#334" BorderThickness="2" CornerRadius="8" Width="140" Height="200" Background="#111122">
                            <TextBlock Text="Drag dweller card here" Foreground="#444" FontSize="11" FontStyle="Italic"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#110A0A" BorderBrush="#223" BorderThickness="1,0,0,0" Padding="8"
                    AllowDrop="True" Drop="OnReturnCardDrop" DragOver="OnAssignmentSlotDragOver">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="♻ RETURN CARD" Foreground="#BB8888" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                    <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border BorderBrush="#433" BorderThickness="2" CornerRadius="8" Width="140" Height="200" Background="#211">
                            <TextBlock Text="Drop item here to unequip" Foreground="#644" FontSize="11" FontStyle="Italic"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="3" Background="#0A0A18" BorderBrush="#223" BorderThickness="1,0,0,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📜 COMBAT LOG" Foreground="#666688" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ScrollViewer Grid.Row="1" x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" Foreground="#556677" FontSize="10" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="GameOverOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#CC000015">
            <Border Background="#0D0D20" BorderBrush="#666" BorderThickness="2" CornerRadius="12"
                    Width="400" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="GameOverTitle"  Text="GAME OVER" Foreground="#DDDDFF"
                               FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="GameOverWinner" Text=""          Foreground="#AAAACC"
                               FontSize="16" HorizontalAlignment="Center" Margin="0,12"/>
                    <Button Content="Play Again" Style="{StaticResource GameButton}"
                            FontSize="13" Padding="20,6" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Click="OnPlayAgain"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DwellerSelectionOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#CC000015">
            <Border Background="#0D0D20" BorderBrush="#334" BorderThickness="2" CornerRadius="12"
                    Width="600" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="SELECT A DWELLER" Foreground="#BBBBDD" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel x:Name="DwellerSelectionList"/>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ConfirmDwellerSelectionBtn" Content="CONFIRM SELECTION" Style="{StaticResource GameButton}" Width="200" Height="36" FontWeight="Bold" Margin="0,0,10,0" Click="OnConfirmDwellerSelection"/>
                        <Button Content="CANCEL" Style="{StaticResource GameButton}" Width="100" Height="36" Click="OnCancelDwellerSelection"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="EquipmentSelectionOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#CC000015">
            <Border Background="#0D0D20" BorderBrush="#334" BorderThickness="2" CornerRadius="12"
                    Width="500" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock x:Name="EquipmentSelectionTitle" Text="SELECT EQUIPMENT" Foreground="#BBBBDD" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel x:Name="EquipmentSelectionList"/>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ConfirmEquipmentSelectionBtn" Content="CONFIRM" Style="{StaticResource GameButton}" Width="150" Height="36" FontWeight="Bold" Margin="0,0,10,0" Click="OnConfirmEquipmentSelection"/>
                        <Button Content="CANCEL" Style="{StaticResource GameButton}" Width="100" Height="36" Click="OnCancelEquipmentSelection"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <Canvas x:Name="DragOverlayCanvas" Grid.RowSpan="4" IsHitTestVisible="False"/>
    </Grid>
</Window>
