<Window x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.BuildRoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build a Room" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D0D20">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Choose a room to build" Foreground="#BBBBDD"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
        <ListBox x:Name="RoomList" Grid.Row="1"
                 Background="#0A0A18" BorderBrush="#334" Foreground="White"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,6">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" Width="200"/>
                        <TextBlock Text="{Binding CostText}" Foreground="#FDCA40" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelBtn" Content="Cancel" Width="80" Margin="0,0,8,0"
                    Background="#1A1A30" Foreground="#888" BorderBrush="#334" Click="OnCancel"/>
            <Button x:Name="BuildBtn"  Content="Build" Width="80" IsEnabled="False"
                    Background="#1A2A1A" Foreground="#66BB66" BorderBrush="#446644" Click="OnBuild"/>
        </StackPanel>
    </Grid>
</Window>
