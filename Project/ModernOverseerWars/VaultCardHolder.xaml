<UserControl x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.VaultCardHolder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="160" MinHeight="220" Margin="0,0,20,0"
             AllowDrop="True" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave" DragOver="OnDragOver"
             PreviewMouseWheel="OnMouseWheel">
    <Border x:Name="HolderBorder" BorderThickness="1.5" CornerRadius="8"
            Background="#0F0F1E" Padding="8">
        <Border.BorderBrush>
            <SolidColorBrush x:Name="HolderBorderColor" Color="#334"/>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="RoomNameText" Grid.Row="0"
                       Text="Room" Foreground="#BBBBCC" FontSize="12" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock x:Name="OutputText"  Grid.Column="0" Text="Output: 0"  FontSize="10" Foreground="#88CCAA" HorizontalAlignment="Center"/>
                <TextBlock x:Name="WorkersText" Grid.Column="1" Text="Workers: 0" FontSize="10" Foreground="#AAAACC" HorizontalAlignment="Center"/>
            </Grid>

            <Canvas x:Name="CardCanvas" Grid.Row="2" MinHeight="160">
                <TextBlock x:Name="EmptyHint" Text="Drop dweller here" Foreground="#44446A"
                           FontSize="11" FontStyle="Italic" Canvas.Left="10" Canvas.Top="60"/>
            </Canvas>

            <StackPanel x:Name="TechPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,6,0,0">
                <Button x:Name="TechAimBtn"  Content="Reliable Aim (15⚡)"  FontSize="9" Margin="0,2"
                        Background="#1A1A30" Foreground="#9999CC" BorderBrush="#334" Click="OnTechAim"/>
                <Button x:Name="TechTankBtn" Content="Frank the Tank (15⚡)" FontSize="9" Margin="0,2"
                        Background="#1A1A30" Foreground="#9999CC" BorderBrush="#334" Click="OnTechTank"/>
            </StackPanel>

            <Button x:Name="ActionButton" Grid.Row="3" Content="+ Assign"
                    Background="#1E1E3A" Foreground="#8888CC" BorderBrush="#334466" BorderThickness="1"
                    FontSize="10" Padding="4,2" Margin="0,4,0,0" Click="OnActionClick"/>
        </Grid>
    </Border>
</UserControl>
