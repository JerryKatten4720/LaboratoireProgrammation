<UserControl x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.ControlCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="140" Height="200"
             Cursor="Hand"
             MouseEnter="OnMouseEnter"
             MouseLeave="OnMouseLeave"
             MouseMove="OnMouseMove"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             PreviewMouseMove="OnPreviewMouseMove"
             PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
             MouseRightButtonDown="OnRightClick"
             ClipToBounds="False">
    <UserControl.Resources>
        <Style x:Key="ThemedContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeFgBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource ThemeFgBrush}" Opacity="0.25" Margin="4,4,4,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"
                                Margin="2,1"
                                Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*" MinWidth="130"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Arrow"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="IconGrid" Grid.Column="0" Margin="0,0,8,0" Width="14" Height="14">
                                    <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CheckMark" Text="✓" Foreground="{DynamicResource ThemeFgBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                                <ContentPresenter x:Name="HeaderHost" Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>

                                <Path x:Name="Arrow" Grid.Column="2"
                                      Data="M 0,0 L 4,4 L 0,8 Z"
                                      Fill="White"
                                      Margin="12,0,4,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                                <Popup x:Name="Popup"
                                       Placement="Right"
                                       HorizontalOffset="4"
                                       VerticalOffset="-4"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource ThemeBgBrush}"
                                            BorderBrush="{DynamicResource ThemeFgBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="6"
                                            Padding="4"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="Black" Opacity="0.4"/>
                                        </Border.Effect>
                                        <ScrollViewer CanContentScroll="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeFgBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeFgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="False" PreviewMouseWheel="OnPreviewMouseWheel">
        <Popup x:Name="EquipmentPopup" Placement="Center" AllowsTransparency="True" IsOpen="False" IsHitTestVisible="False">
            <Canvas x:Name="EquipmentCanvas" ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Top" Width="140" Height="200" Panel.ZIndex="0">
                <Border x:Name="WeaponCardContainer" Canvas.Left="5" Canvas.Top="10" Width="110" Height="157" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><RotateTransform Angle="-5"/></Border.RenderTransform>
                </Border>
                <Border x:Name="OutfitCardContainer" Canvas.Left="25" Canvas.Top="10" Width="110" Height="157" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><RotateTransform Angle="5"/></Border.RenderTransform>
                </Border>
            </Canvas>
        </Popup>
        
        <Grid x:Name="MainCardGrid" Background="Transparent" ClipToBounds="False" Panel.ZIndex="1" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="TiltScale" ScaleX="1" ScaleY="1"/>
                    <SkewTransform x:Name="TiltSkew" AngleX="0" AngleY="0"/>
                    <RotateTransform x:Name="TiltRotate" Angle="0"/>
                    <TranslateTransform x:Name="TremorTransform" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.Effect>
                <DropShadowEffect x:Name="CardGlow" BlurRadius="0" ShadowDepth="0" Color="Transparent" Opacity="0"/>
            </Grid.Effect>

            <Image Source="../../Assets/images/overseerWars/cards/card_circle.png" Stretch="Fill"/>
            <Image x:Name="ImgDweller" Source="../../Assets/images/overseerWars/dwellers/dweller.png"
                   Stretch="Uniform" Width="160" Height="160"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="10,70,0,0" RenderTransformOrigin="0.5,0.5"/>
            <Image Source="../../Assets/images/overseerWars/cards/card_circleborder.png" Stretch="Fill"/>
            <Image x:Name="ImgTop" Source="../../Assets/images/overseerWars/cards/card_top_common.png" Stretch="Fill"/>
            <Image x:Name="ImgColor" Source="../../Assets/images/overseerWars/cards/card_color_common.png" Stretch="Fill"/>
            <Image x:Name="ImgBorder" Source="../../Assets/images/overseerWars/cards/card_border_common.png" Stretch="Fill"/>

            <!-- Holofoil Sweep Overlay -->
            <Border x:Name="HolofoilOverlay" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.9">
                <Border.Background>
                    <LinearGradientBrush x:Name="HolofoilBrush" StartPoint="0,0" EndPoint="1,1" MappingMode="RelativeToBoundingBox">
                        <LinearGradientBrush.Transform>
                            <TranslateTransform x:Name="HolofoilTransform" X="-1.5" Y="-1.5" />
                        </LinearGradientBrush.Transform>
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.65"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid VerticalAlignment="Bottom" Margin="6,0,6,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                        <Border x:Name="SupervisorBadge" Background="#CC8800" CornerRadius="3"
                                Padding="3,1" Margin="0,0,4,0" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock Text="★" FontSize="8" FontWeight="Bold" Foreground="Black"/>
                        </Border>
                        
                        <TextBlock Text="{Binding CardImage, ElementName=Root}"
                                   FontSize="12" FontWeight="Bold" Padding="0,0,0,122.5" Foreground="White"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.7"/>
                        
                    </StackPanel>
                    
                    
                    <TextBlock x:Name="StatsLine" Text="S:3 P:3 E:3 C:3" FontSize="9" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <Grid Margin="0,3,0,0">
                        <ProgressBar x:Name="HpBar" Margin="5,0,5,10" Height="15" Minimum="0" Maximum="100" Value="100" Background="#44333333" Foreground="#22BB44" BorderThickness="0" Opacity="0.8"/>
                        <TextBlock x:Name="HpText" Text="HP" FontSize="10.8" Foreground="White" HorizontalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
