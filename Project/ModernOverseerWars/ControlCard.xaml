<UserControl x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.ControlCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="200" Height="auto">
    <Border BorderBrush="Black" BorderThickness="0" CornerRadius="5" Background="Transparent" Margin="5">
        <StackPanel VerticalAlignment="Center">
            <Image Source="../../Assets/images/overseerWars/cards/back.png" />
            <TextBlock Text="{Binding CardImage, ElementName=Root}"
                       HorizontalAlignment="Center"
                       FontWeight="Bold" />
        </StackPanel>
    </Border>
</UserControl>