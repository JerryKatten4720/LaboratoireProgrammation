<UserControl x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.Views.DeckPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="220" FontFamily="Consolas">
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="TabButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentDimBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccentDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayerBgBrush}" BorderBrush="{DynamicResource PlayerAccentDimBrush}" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="[ INVENTORY ]" Foreground="{DynamicResource PlayerAccentBrush}" Effect="{DynamicResource PlayerAccentGlow}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,32,0"/>
                <Button x:Name="TabDwellersBtn" Content="DWELLERS" Click="OnTabDwellers" Style="{StaticResource TabButton}"/>
                <Button x:Name="TabWeaponsBtn" Content="WEAPONS" Click="OnTabWeapons" Style="{StaticResource TabButton}"/>
                <Button x:Name="TabOutfitsBtn" Content="OUTFITS" Click="OnTabOutfits" Style="{StaticResource TabButton}"/>
                <Button x:Name="TabScrapsBtn" Content="SCRAPS" Click="OnTabScraps" Style="{StaticResource TabButton}"/>
                <TextBlock x:Name="DeckCountText" Text="> 0 UNITS DETECTED" Foreground="{DynamicResource PlayerAccentDimBrush}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
            <ScrollViewer x:Name="DeckScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnPreviewMouseWheel">
                <StackPanel x:Name="CardRow" Orientation="Horizontal" Margin="0,4,0,0"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>