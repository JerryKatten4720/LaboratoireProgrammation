<Window x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.Views.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROBCO INDUSTRIES UNIFIED OPERATING SYSTEM - OVERSEER WARS"
        Height="720" Width="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" WindowStyle="None"
        Background="#141414"
        FontFamily="Consolas">

    <Window.Resources>
        <SolidColorBrush x:Key="TerminalGreen" Color="#FFC346"/>
        <SolidColorBrush x:Key="TerminalDim" Color="#FFC346"/>
        
        <DropShadowEffect x:Key="PhosphorGlow" Color="#47FFC346" BlurRadius="170" ShadowDepth="8" Opacity="0.2"/>
        
        <Style TargetType="TextBlock" x:Key="TerminalText">
            <Setter Property="Foreground" Value="{StaticResource TerminalGreen}"/>
            <Setter Property="Effect" Value="{StaticResource PhosphorGlow}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style TargetType="TextBox" x:Key="TerminalInput">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TerminalGreen}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TerminalGreen}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,16,0,24"/>
            <Setter Property="CaretBrush" Value="{StaticResource TerminalGreen}"/>
            <Setter Property="Effect" Value="{StaticResource PhosphorGlow}"/>
        </Style>

        <Style TargetType="Button" x:Key="TerminalButton">
            <Setter Property="Background" Value="#00141414"/>
            <Setter Property="Foreground" Value="{StaticResource TerminalGreen}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TerminalGreen}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="32,16"/>
            <Setter Property="Effect" Value="{StaticResource PhosphorGlow}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource TerminalGreen}"/>
                                <Setter Property="Foreground" Value="#020A04"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="64">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,48" HorizontalAlignment="Center">
            <TextBlock Text="[ VAULT-TEC TERMINAL LINK ESTABLISHED ]" 
                       Style="{StaticResource TerminalText}" FontSize="18" HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,8"/>
            <TextBlock Text="OVERSEER WARS: INITIATION PROTOCOL" 
                       Style="{StaticResource TerminalText}" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Rectangle Height="2" Fill="{StaticResource TerminalGreen}" Margin="0,16,0,0" Effect="{StaticResource PhosphorGlow}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="> IDENTIFY CANDIDATE ALPHA (P1)" Style="{StaticResource TerminalText}" FontSize="16" Opacity="0.8" Margin="0,0,0,8"/>
                <TextBox x:Name="P1Name" Text="Wanderer" Style="{StaticResource TerminalInput}"/>
                
                <TextBlock Text="> SELECT HUD SPECTRAL SIGNATURE" Style="{StaticResource TerminalText}" FontSize="16" Opacity="0.8" Margin="0,0,0,16"/>
                <ItemsControl x:Name="P1Themes">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ThemeDot" Width="48" Height="48" CornerRadius="4" Margin="0,0,12,12"
                                    Cursor="Hand" Tag="{Binding}"
                                    MouseLeftButtonDown="OnP1ThemeClick">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding DisplayColor}"/>
                                </Border.Background>
                                <TextBlock x:Name="CheckMark" Text="[X]" Style="{StaticResource TerminalText}"
                                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="P1Preview" Height="64" Margin="0,32,0,0" BorderThickness="1" BorderBrush="{StaticResource TerminalDim}">
                    <TextBlock x:Name="P1PreviewText" Text="PREVIEW" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48" FontFamily="#overseer"/>
                </Border>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="2" Fill="{StaticResource TerminalDim}" Margin="31,0"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="> IDENTIFY CANDIDATE BETA (P2)" Style="{StaticResource TerminalText}" FontSize="16" Opacity="0.8" Margin="0,0,0,8"/>
                <TextBox x:Name="P2Name" Text="Courier" Style="{StaticResource TerminalInput}"/>
                
                <TextBlock Text="> SELECT HUD SPECTRAL SIGNATURE" Style="{StaticResource TerminalText}" FontSize="16" Opacity="0.8" Margin="0,0,0,16"/>
                <ItemsControl x:Name="P2Themes">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="48" Height="48" CornerRadius="4" Margin="0,0,12,12"
                                    Cursor="Hand" Tag="{Binding}"
                                    MouseLeftButtonDown="OnP2ThemeClick">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding DisplayColor}"/>
                                </Border.Background>
                                <TextBlock x:Name="CheckMark2" Text="[X]" Style="{StaticResource TerminalText}"
                                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="P2Preview" Height="64" Margin="0,32,0,0" BorderThickness="1" BorderBrush="{StaticResource TerminalDim}">
                    <TextBlock x:Name="P2PreviewText" Text="PREVIEW" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48" FontFamily="#overseer"/>
                </Border>
            </StackPanel>

            <Image Source="../../Assets/images/vaultTec.png" Grid.ColumnSpan="3" HorizontalAlignment="Center" Panel.ZIndex="-5" Opacity="0.05" Stretch="Uniform"/>
        </Grid>

        <Button Grid.Row="2" x:Name="StartBtn" Content="> INITIALIZE SIMULATION" Style="{StaticResource TerminalButton}" Click="OnStart" Margin="0,64,0,0"/>
    </Grid>
</Window>