<UserControl x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.Views.ControlCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="140" Height="200"
             Cursor="Hand"
             MouseEnter="OnMouseEnter"
             MouseLeave="OnMouseLeave"
             MouseMove="OnMouseMove"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             PreviewMouseMove="OnPreviewMouseMove"
             PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
             MouseRightButtonDown="OnRightClick"
             ClipToBounds="False"
             FontFamily="Consolas">
             
    <UserControl.Resources>
        <DropShadowEffect x:Key="TerminalGlow" Color="{Binding Foreground.Color, RelativeSource={RelativeSource Mode=Self}}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>

        <Style x:Key="ThemedContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeFgBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource ThemeFgBrush}" Opacity="0.4" Margin="8,2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeFgBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                SnapsToDevicePixels="True"
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*" MinWidth="130"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Arrow"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="IconGrid" Grid.Column="0" Margin="0,0,8,0" Width="14" Height="14">
                                    <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CheckMark" Text="[X]" Foreground="{DynamicResource ThemeFgBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                                <ContentPresenter x:Name="HeaderHost" Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>

                                <Path x:Name="Arrow" Grid.Column="2"
                                      Data="M 0,0 L 4,4 L 0,8 Z"
                                      Fill="{DynamicResource ThemeFgBrush}"
                                      Margin="12,0,4,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                                <Popup x:Name="Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="0" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource ThemeBgBrush}" BorderBrush="{DynamicResource ThemeFgBrush}" BorderThickness="2" Padding="0" SnapsToDevicePixels="True">
                                        <ScrollViewer CanContentScroll="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeFgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBgBrush}"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeBgBrush}"/>
                                <Setter TargetName="CheckMark" Property="Foreground" Value="{DynamicResource ThemeBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar" x:Key="TerminalHpBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>
                                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="False">
        <Grid x:Name="MainCardGrid" Background="Transparent" ClipToBounds="False" Panel.ZIndex="1" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="TiltScale" ScaleX="1" ScaleY="1"/>
                    <SkewTransform x:Name="TiltSkew" AngleX="0" AngleY="0"/>
                    <RotateTransform x:Name="TiltRotate" Angle="0"/>
                    <TranslateTransform x:Name="TremorTransform" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.Effect>
                <DropShadowEffect x:Name="CardGlow" BlurRadius="0" ShadowDepth="0" Color="Transparent" Opacity="0"/>
            </Grid.Effect>

            <Image Source="/Assets/images/overseerWars/cards/card_circle.png" Stretch="Fill"/>
            <Image x:Name="ImgDweller" Source="/Assets/images/overseerWars/dwellers/dweller.png"
                   Stretch="Uniform" Width="160" Height="160"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="10,70,0,0" RenderTransformOrigin="0.5,0.5"/>
            <Image Source="/Assets/images/overseerWars/cards/card_circleborder.png" Stretch="Fill"/>
            <Image x:Name="ImgTop" Source="/Assets/images/overseerWars/cards/card_top_common.png" Stretch="Fill"/>
            <Image x:Name="ImgColor" Source="/Assets/images/overseerWars/cards/card_color_common.png" Stretch="Fill"/>
            <Image x:Name="ImgBorder" Source="/Assets/images/overseerWars/cards/card_border_common.png" Stretch="Fill"/>

            <Border x:Name="HolofoilOverlay" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.9">
                <Border.Background>
                    <LinearGradientBrush x:Name="HolofoilBrush" StartPoint="0,0" EndPoint="1,1" MappingMode="RelativeToBoundingBox">
                        <LinearGradientBrush.Transform>
                            <TranslateTransform x:Name="HolofoilTransform" X="-1.5" Y="-1.5" />
                        </LinearGradientBrush.Transform>
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.65"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid VerticalAlignment="Bottom" Margin="6,0,6,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                        <Border x:Name="SupervisorBadge" Background="#FFD700" CornerRadius="0"
                                Padding="4,2" Margin="0,0,4,0" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock Text="★ SUP" FontSize="8" FontWeight="Bold" Foreground="Black"/>
                        </Border>
                        
                        <TextBlock Text="{Binding CardImage, ElementName=Root}"
                                   FontSize="12" FontWeight="Bold" Padding="0,0,0,122.5" Foreground="White"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.9"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="StatsLine" Text="S:3 P:3 E:3 C:3" FontSize="10" FontWeight="Bold" Foreground="#DDDDDD" HorizontalAlignment="Center"/>
                    
                    <Grid Margin="0,4,0,0">
                        <ProgressBar x:Name="HpBar" Style="{StaticResource TerminalHpBar}" Margin="8,0,8,12" Height="14" Minimum="0" Maximum="100" Value="100" Background="#33000000" Foreground="#1BFD02" Opacity="0.9"/>
                        <TextBlock x:Name="HpText" Text="HP" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Effect="{StaticResource TerminalGlow}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>