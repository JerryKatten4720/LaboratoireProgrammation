<UserControl x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.Views.HexTileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modernOverseerWars="clr-namespace:LaboratoireProgrammation.Project.ModernOverseerWars.Views"
             Width="100" Height="100"
             Cursor="Hand"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             MouseEnter="OnHoverEnter"
             MouseLeave="OnHoverLeave"
             PreviewMouseWheel="OnMouseWheel"
             MouseRightButtonDown="OnRightClick"
             AllowDrop="True"
             Drop="OnDrop"
             DragEnter="OnDragEnterTile"
             DragLeave="OnDragLeaveTile"
             DragOver="OnDragOverTile">
    <Grid>
        <Popup x:Name="WastelandCardPopup" Placement="Right" PlacementTarget="{Binding ElementName=HexShape}" AllowsTransparency="True" IsOpen="False">
            <modernOverseerWars:ControlCard x:Name="WastelandHoverCard" IsHitTestVisible="False" Margin="10,0,0,0"/>
        </Popup>
        <Rectangle x:Name="HexShape" StrokeThickness="1" Width="100" Height="100" SnapsToDevicePixels="True"/>
        <Rectangle x:Name="ReachableOverlay" Width="100" Height="100" Visibility="Collapsed" SnapsToDevicePixels="True"/>
        <Rectangle x:Name="HoverOverlay" Fill="#33FFFFFF" Visibility="Collapsed" IsHitTestVisible="False" Width="100" Height="100"/>
        <Ellipse x:Name="PathOverlay" Fill="#A5FFD700" Visibility="Collapsed" IsHitTestVisible="False" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Rectangle x:Name="SelectedOverlay" Stroke="White" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False" Width="100" Height="100"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.3" IsHitTestVisible="False">
            <TextBlock x:Name="TileIcon"    Text="?" FontSize="22" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TileLabel"   Text=""  FontSize="8"  Foreground="#AAAACC"
                        HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="80" TextAlignment="Center"/>
        </StackPanel>
        <Grid x:Name="DwellersPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
