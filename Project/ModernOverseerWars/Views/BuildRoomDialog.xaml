<Window x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.Views.BuildRoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROBCO SCHEMATICS" Height="520" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        Background="#08080C" FontFamily="Consolas">

    <Window.Resources>
        <SolidColorBrush x:Key="PlayerAccentBrush" Color="#FFC346"/>
        <SolidColorBrush x:Key="PlayerAccentDimBrush" Color="#44FFC346"/>
        <SolidColorBrush x:Key="PlayerBgBrush" Color="#141414"/>
        <DropShadowEffect x:Key="PlayerAccentGlow" Color="#FFC346" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>

        <Style TargetType="TextBlock" x:Key="TerminalText">
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
            <Setter Property="Effect" Value="{DynamicResource PlayerAccentGlow}"/>
        </Style>

        <Style TargetType="Button" x:Key="GameButton">
            <Setter Property="Background" Value="#0A0A0F"/>
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{DynamicResource PlayerAccentGlow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PlayerAccentBrush}"/>
                                <Setter Property="Foreground" Value="#08080C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource PlayerAccentBrush}" BorderThickness="2" Margin="12" Padding="24" Background="{DynamicResource PlayerBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="[ VAULT-TEC ARCHITECTURAL SCHEMATICS ]" Style="{StaticResource TerminalText}" FontSize="18" FontWeight="Bold"/>
                <Rectangle Height="1" Fill="{DynamicResource PlayerAccentDimBrush}" Margin="0,12,0,0"/>
            </StackPanel>

            <ListBox x:Name="RoomList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSelectionChanged">
                
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" BorderThickness="1" BorderBrush="{DynamicResource PlayerAccentDimBrush}" Background="#05000000" Margin="0,0,0,12" Padding="16" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="60" Height="60" Background="#0A000000" BorderBrush="{DynamicResource PlayerAccentDimBrush}" BorderThickness="1" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Icon}" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TerminalText}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#888899" TextWrapping="Wrap" Margin="0,6,16,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="REQUIRED" FontSize="10" Foreground="#888899" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding CostText}" Style="{StaticResource TerminalText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PlayerAccentBrush}"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#11FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PlayerAccentBrush}"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PlayerAccentDimBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelBtn" Content="> ABORT" Style="{StaticResource GameButton}" Width="120" Margin="0,0,16,0" Click="OnCancel"/>
                <Button x:Name="BuildBtn" Content="> INITIATE BUILD" Style="{StaticResource GameButton}" Width="180" IsEnabled="False" Click="OnBuild"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>