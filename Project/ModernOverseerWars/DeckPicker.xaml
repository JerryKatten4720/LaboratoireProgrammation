<UserControl x:Class="LaboratoireProgrammation.Project.ModernOverseerWars.DeckPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="220">
    <Border Background="#0A0A1A" BorderBrush="#223" BorderThickness="0,1,0,0" Padding="8,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="📋 DECK" Foreground="#8888BB" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="TabDwellersBtn" Content="DWELLERS" Click="OnTabDwellers" Margin="0,0,5,0" Padding="8,2" FontSize="9" Background="#1E1E38" Foreground="White" BorderBrush="#334"/>
                <Button x:Name="TabWeaponsBtn" Content="WEAPONS" Click="OnTabWeapons" Margin="0,0,5,0" Padding="8,2" FontSize="9" Background="#1E1E38" Foreground="White" BorderBrush="#334"/>
                <Button x:Name="TabOutfitsBtn" Content="OUTFITS" Click="OnTabOutfits" Margin="0,0,5,0" Padding="8,2" FontSize="9" Background="#1E1E38" Foreground="White" BorderBrush="#334"/>
                <Button x:Name="TabScrapsBtn" Content="SCRAPS" Click="OnTabScraps" Margin="0,0,10,0" Padding="8,2" FontSize="9" Background="#1E1E38" Foreground="White" BorderBrush="#334"/>
                <TextBlock x:Name="DeckCountText" Text=" — 0 cards" Foreground="#556" FontSize="10" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer x:Name="DeckScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnPreviewMouseWheel">
                <StackPanel x:Name="CardRow" Orientation="Horizontal" Margin="0,4,0,0"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
