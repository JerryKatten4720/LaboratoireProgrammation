<Window x:Class="LaboratoireProgrammation.Project.ModernHospital.AddExtraFeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter des Frais Supplémentaires" Height="250" Width="360"
        WindowStartupLocation="CenterOwner" Background="#1c1c22">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f0f0f5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#18181e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2a2a38"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Nom du frais supplémentaire" FontSize="11" Foreground="#8888aa"/>
            <TextBox x:Name="TbNomFrais"/>

            <TextBlock Text="Prix (en $)" FontSize="11" Foreground="#8888aa"/>
            <TextBox x:Name="TbMontant"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Annuler" Click="BtnCancel_Click" Height="34" Background="#2a2a38" Foreground="#f0f0f5" BorderThickness="0"/>
                <Button Grid.Column="2" Content="Ajouter" Click="BtnSave_Click" Height="34" Background="#00d4aa" Foreground="#0d0d0f" BorderThickness="0" FontFamily="Segoe UI Semibold"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
