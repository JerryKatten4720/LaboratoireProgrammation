<UserControl x:Class="LaboratoireProgrammation.Project.ModernHospital.MenuPopper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             x:Name="RootComponent">

    <UserControl.Resources>
        <Style x:Key="ModernHospitalButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Height" Value="50" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{Binding OutlineBrush, ElementName=RootComponent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1AFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#B3000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Width="488"
                Height="315"
                Background="#121212"
                BorderBrush="{Binding OutlineBrush, ElementName=RootComponent}"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="#181818"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Padding="12,8,18,8"
                        BorderBrush="{Binding OutlineBrush, ElementName=RootComponent}"
                        BorderThickness="0,0,1,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="✚ " Foreground="{Binding OutlineBrush, ElementName=RootComponent}"
                                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="RUE DE LONDRES"
                                       Foreground="{Binding OutlineBrush, ElementName=RootComponent}" FontSize="9"
                                       FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="MEMORIAL" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,1" />
                        <TextBlock Text="SAFEZONE • HOSPITAL" Foreground="#555555" FontSize="8" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="{Binding MessageText, ElementName=RootComponent}"
                           Foreground="White"
                           FontSize="20"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           LineHeight="28" />

                <UniformGrid Grid.Row="2" Columns="2" Margin="18,0,18,24">
                    <Button Content="YES" Style="{StaticResource ModernHospitalButtonStyle}" Margin="0,0,8,0"
                            Click="YesButton_Click" />
                    <Button Content="NO" Style="{StaticResource ModernHospitalButtonStyle}" Margin="8,0,0,0"
                            Click="NoButton_Click" />
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>