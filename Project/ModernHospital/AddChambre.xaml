<Window x:Class="LaboratoireProgrammation.Project.ModernHospital.AddChambreForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" SizeToContent="WidthAndHeight">

    <Window.Resources>

        <SolidColorBrush x:Key="TextPrimary" Color="#f0f0f5" />
        <SolidColorBrush x:Key="Border" Color="#2a2a38" />

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1c1c22" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1c1c22"
                                                BorderBrush="{StaticResource Border}"
                                                BorderThickness="1">
                                            <Path x:Name="Arrow"
                                                  Fill="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,5,0" Data="M 0 0 L 4 4 L 8 0 Z" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#18181e"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource Border}" />
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True"
                                                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#1c1c22" CornerRadius="12" Width="360" Height="330"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                BorderBrush="#2a2a38" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Ajouter une chambre" Foreground="#f0f0f5"
                           FontFamily="Segoe UI Semibold" FontSize="18" Margin="0,0,0,20" />

                <TextBlock Text="Unité de rattachement" Foreground="#8888aa" FontSize="11" Margin="0,0,0,4" />
                <ComboBox x:Name="CbUnite" DisplayMemberPath="Nom" Height="32" Background="#18181e"
                          Foreground="#f0f0f5" Margin="0,0,0,16" />

                <TextBlock Text="Numéro de Chambre" Foreground="#8888aa" FontSize="11" Margin="0,0,0,4" />
                <TextBox x:Name="TbNumeroChambre" Height="38" Background="#18181e" Foreground="#f0f0f5" Padding="8,0" VerticalContentAlignment="Center"
                         Margin="0,0,0,16" />

                <TextBlock Text="Type de Chambre" Foreground="#8888aa" FontSize="11" Margin="0,0,0,4" />
                <ComboBox x:Name="CbType" Height="32" Background="#18181e" Foreground="#f0f0f5" Margin="0,0,0,24">
                    <ComboBoxItem Content="Standard - Individuel" />
                    <ComboBoxItem Content="Standard - Commune" />
                    <ComboBoxItem Content="Soins Intensifs" />
                    <ComboBoxItem Content="Isolement" />
                    <ComboBoxItem Content="Bloc Opératoire" />
                </ComboBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Annuler" Click="BtnCancel_Click"
                            Background="#2a2a38" Foreground="#f0f0f5" Height="34" BorderThickness="0" />
                    <Button Grid.Column="2" Content="Sauvegarder" Click="BtnSave_Click"
                            Background="#00d4aa" Foreground="#0d0d0f" Height="34" BorderThickness="0"
                            FontFamily="Segoe UI Semibold" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>