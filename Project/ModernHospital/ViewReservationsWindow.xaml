<Window x:Class="LaboratoireProgrammation.Project.ModernHospital.ViewReservationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réservations en attente" Height="450" Width="700"
        WindowStartupLocation="CenterOwner" Background="#1c1c22">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#f0f0f5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8888aa" />
        <SolidColorBrush x:Key="BgCard" Color="#18181e" />
        <SolidColorBrush x:Key="Border" Color="#2a2a38" />

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2a2a38" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3a3a4d" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Patients ayant une réservation" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Semibold" FontSize="18" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <ListView x:Name="LvReservations" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Patient" DisplayMemberBinding="{Binding Nom}" Width="150" />
                        <GridViewColumn Header="Chambre" DisplayMemberBinding="{Binding NumeroChambre}" Width="80" />
                        <GridViewColumn Header="Médecin" DisplayMemberBinding="{Binding MedecinEnCharge}" Width="150" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fermer" Style="{StaticResource ActionBtn}" Click="BtnClose_Click" Margin="0,0,10,0"/>
            <Button Content="Admettre le patient sélectionné" Style="{StaticResource ActionBtn}" Background="#00d4aa" Foreground="#0d0d0f" Click="BtnAdmettre_Click"/>
        </StackPanel>
    </Grid>
</Window>
