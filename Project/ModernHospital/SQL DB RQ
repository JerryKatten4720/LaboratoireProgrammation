DROP DATABASE IF EXISTS LAB_HOPITAL;
CREATE DATABASE LAB_HOPITAL;
USE LAB_HOPITAL;

CREATE TABLE Hopital (
                         IdHopital INT AUTO_INCREMENT PRIMARY KEY,
                         Nom VARCHAR(150) NOT NULL,
                         DirecteurGeneral VARCHAR(100),
                         DirecteurMedical VARCHAR(100),
                         Budget DECIMAL(15, 2) DEFAULT 500000.00,
                         Reputation INT DEFAULT 50,
                         JourSimulation INT DEFAULT 1,
                         HeureSimulation TIME DEFAULT '08:00:00',
                         MontantEmprunt DECIMAL(15, 2) DEFAULT 0.00,
                         TauxInteret DECIMAL(5, 2) DEFAULT 0.05
);

CREATE TABLE Aile (
                      IdAile INT AUTO_INCREMENT PRIMARY KEY,
                      IdHopital INT NOT NULL,
                      Nom VARCHAR(100) NOT NULL,
                      FonctionPrincipale VARCHAR(255),
                      FOREIGN KEY (IdHopital) REFERENCES Hopital(IdHopital) ON DELETE CASCADE
);

CREATE TABLE Departement (
                             IdDepartement INT AUTO_INCREMENT PRIMARY KEY,
                             IdAile INT NOT NULL,
                             Nom VARCHAR(100) NOT NULL,
                             ChefDeDepartement VARCHAR(100),
                             FOREIGN KEY (IdAile) REFERENCES Aile(IdAile) ON DELETE CASCADE
);

CREATE TABLE Service (
                         IdService INT AUTO_INCREMENT PRIMARY KEY,
                         IdDepartement INT NOT NULL,
                         Nom VARCHAR(100) NOT NULL,
                         ChefDeService VARCHAR(100),
                         FOREIGN KEY (IdDepartement) REFERENCES Departement(IdDepartement) ON DELETE CASCADE
);

CREATE TABLE Unite (
                       IdUnite INT AUTO_INCREMENT PRIMARY KEY,
                       IdService INT NOT NULL,
                       Nom VARCHAR(100) NOT NULL,
                       CadreDeSante VARCHAR(100),
                       CoutEntretienJour DECIMAL(10, 2) DEFAULT 500.00,
                       FOREIGN KEY (IdService) REFERENCES Service(IdService) ON DELETE CASCADE
);

CREATE TABLE Salle_Attente (
                               IdSalle INT AUTO_INCREMENT PRIMARY KEY,
                               IdUnite INT NOT NULL,
                               CapaciteMax INT DEFAULT 20,
                               IdPersonnelAccueil INT,
                               FOREIGN KEY (IdUnite) REFERENCES Unite(IdUnite) ON DELETE CASCADE
);

CREATE TABLE Chambre (
                         IdChambre INT AUTO_INCREMENT PRIMARY KEY,
                         IdUnite INT NOT NULL,
                         NumeroChambre VARCHAR(20) NOT NULL,
                         TypeChambre ENUM('Standard - Individuel', 'Standard - Commune', 'Soins Intensifs', 'Isolement', 'Bloc Opératoire') NOT NULL,
                         NiveauEquipement INT DEFAULT 1,
                         NiveauSalete INT DEFAULT 0,
                         FOREIGN KEY (IdUnite) REFERENCES Unite(IdUnite) ON DELETE CASCADE
);

CREATE TABLE Lit (
                     IdLit INT AUTO_INCREMENT PRIMARY KEY,
                     IdChambre INT NOT NULL,
                     NumeroLit VARCHAR(10) NOT NULL,
                     Statut ENUM('Libre', 'Occupé', 'En Nettoyage', 'Maintenance', 'Réservé') DEFAULT 'Libre',
                     FOREIGN KEY (IdChambre) REFERENCES Chambre(IdChambre) ON DELETE CASCADE
);

