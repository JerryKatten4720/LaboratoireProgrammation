CREATE TABLE To_Hire (
                         IdCandidat INT AUTO_INCREMENT PRIMARY KEY,
                         Nom VARCHAR(50) NOT NULL,
                         Prenom VARCHAR(50) NOT NULL,
                         Categorie VARCHAR(100) NOT NULL,
                         RoleExact VARCHAR(100) NOT NULL,
                         Specialite VARCHAR(100),
                         NiveauCompetence INT NOT NULL,
                         SalaireJour DECIMAL(10, 2) NOT NULL,
                         PrimeEmbauche DECIMAL(10, 2) NOT NULL
);

CREATE TABLE Personnel_Actif (
                                 IdEmploye INT AUTO_INCREMENT PRIMARY KEY,
                                 IdUnite INT,
                                 Nom VARCHAR(50) NOT NULL,
                                 Prenom VARCHAR(50) NOT NULL,
                                 Categorie VARCHAR(100) NOT NULL,
                                 RoleExact VARCHAR(100) NOT NULL,
                                 Specialite VARCHAR(100),
                                 NiveauCompetence INT NOT NULL,
                                 Experience INT DEFAULT 0,
                                 Energie INT DEFAULT 100,
                                 Faim INT DEFAULT 100,
                                 Vessie INT DEFAULT 100,
                                 Stress INT DEFAULT 0,
                                 SalaireJour DECIMAL(10, 2) NOT NULL,
                                 Shift ENUM('Jour', 'Nuit') DEFAULT 'Jour',
                                 Statut ENUM('En poste', 'En pause', 'Absent', 'Épuisé') DEFAULT 'En poste',
                                 FOREIGN KEY (IdUnite) REFERENCES Unite(IdUnite) ON DELETE SET NULL
);

CREATE TABLE Candidat_Trait (
                                IdCandidat INT,
                                IdTrait INT,
                                PRIMARY KEY (IdCandidat, IdTrait),
                                FOREIGN KEY (IdCandidat) REFERENCES To_Hire(IdCandidat) ON DELETE CASCADE,
                                FOREIGN KEY (IdTrait) REFERENCES TraitsPersona(IdTrait) ON DELETE CASCADE
);

CREATE TABLE Employe_Trait (
                               IdEmploye INT,
                               IdTrait INT,
                               PRIMARY KEY (IdEmploye, IdTrait),
                               FOREIGN KEY (IdEmploye) REFERENCES Personnel_Actif(IdEmploye) ON DELETE CASCADE,
                               FOREIGN KEY (IdTrait) REFERENCES TraitsPersona(IdTrait) ON DELETE CASCADE
);

CREATE TABLE Competence_Candidat (
                                     IdCandidat INT,
                                     IdUnite INT,
                                     Score INT DEFAULT 0 CHECK (Score >= 0 AND Score <= 10),
                                     PRIMARY KEY (IdCandidat, IdUnite),
                                     FOREIGN KEY (IdCandidat) REFERENCES To_Hire(IdCandidat) ON DELETE CASCADE,
                                     FOREIGN KEY (IdUnite) REFERENCES Unite(IdUnite) ON DELETE CASCADE
);

CREATE TABLE Competence_Employe (
                                    IdEmploye INT,
                                    IdUnite INT,
                                    Score INT DEFAULT 0 CHECK (Score >= 0 AND Score <= 10),
                                    PRIMARY KEY (IdEmploye, IdUnite),
                                    FOREIGN KEY (IdEmploye) REFERENCES Personnel_Actif(IdEmploye) ON DELETE CASCADE,
                                    FOREIGN KEY (IdUnite) REFERENCES Unite(IdUnite) ON DELETE CASCADE
);

