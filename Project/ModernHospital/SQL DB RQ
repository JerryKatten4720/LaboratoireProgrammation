CREATE TABLE Patients_Actifs (
                                 IdPatient INT AUTO_INCREMENT PRIMARY KEY,
                                 Nom VARCHAR(100) NOT NULL,
                                 IdMaladie INT NOT NULL,
                                 IdLit INT,
                                 IdMedecinAssigné INT,
                                 SanteActuelle INT DEFAULT 100,
                                 Satisfaction INT DEFAULT 100,
                                 Classe ENUM('Standard', 'VIP', 'Non-assuré') DEFAULT 'Standard',
                                 TempsTraitementRestant INT,
                                 Statut ENUM('En Attente', 'En Diagnostic', 'En Traitement', 'Guéri', 'Décédé') DEFAULT 'En Attente',
                                 DateEntree INT,
                                 IdFacture INT,
                                 FOREIGN KEY (IdMaladie) REFERENCES Cas_Cliniques(IdCas),
                                 FOREIGN KEY (IdLit) REFERENCES Lit(IdLit) ON DELETE SET NULL,
                                 FOREIGN KEY (IdMedecinAssigné) REFERENCES Personnel_Actif(IdEmploye) ON DELETE SET NULL
);

CREATE TABLE Transactions_Financieres (
                                          IdTransaction INT AUTO_INCREMENT PRIMARY KEY,
                                          JourSimulation INT NOT NULL,
                                          TypeTransaction ENUM('Revenu Patient', 'Paiement Salaire', 'Achat Équipement', 'Embauche', 'Frais Entretien', 'Remboursement Prêt', 'Facturation Patient') NOT NULL,
                                          Montant DECIMAL(15, 2) NOT NULL,
                                          Description VARCHAR(255),
                                          IdFacture INT
);

CREATE VIEW Helper_Structure_Hopital AS
SELECT
    h.Nom AS Hopital,
    a.Nom AS Aile,
    d.Nom AS Departement,
    s.Nom AS Service,
    u.Nom AS Unite,
    u.CadreDeSante,
    u.CoutEntretienJour
FROM Hopital h
         JOIN Aile a ON h.IdHopital = a.IdHopital
         JOIN Departement d ON a.IdAile = d.IdAile
         JOIN Service s ON d.IdDepartement = s.IdDepartement
         JOIN Unite u ON s.IdService = u.IdService;

CREATE VIEW Helper_Disponibilite_Lits AS
SELECT
    u.Nom AS Unite,
    c.NumeroChambre,
    c.TypeChambre,
    c.NiveauSalete,
    l.IdLit,
    l.NumeroLit,
    l.Statut
FROM Lit l
         JOIN Chambre c ON l.IdChambre = c.IdChambre
         JOIN Unite u ON c.IdUnite = u.IdUnite
WHERE l.Statut = 'Libre';

CREATE VIEW Helper_Patients_Dashboard AS
SELECT
    p.IdPatient,
    p.Nom AS Patient,
    m.Maladie,
    p.SanteActuelle,
    p.Satisfaction,
    p.Classe,
    p.Statut,
    c.NumeroChambre,
    l.NumeroLit,
    med.Nom AS MedecinEnCharge
FROM Patients_Actifs p
         JOIN Cas_Cliniques m ON p.IdMaladie = m.IdCas
         LEFT JOIN Lit l ON p.IdLit = l.IdLit
         LEFT JOIN Chambre c ON l.IdChambre = c.IdChambre
         LEFT JOIN Personnel_Actif med ON p.IdMedecinAssigné = med.IdEmploye;

CREATE TABLE Facture (
    IdFacture INT AUTO_INCREMENT PRIMARY KEY,
    IdPatient INT NOT NULL,
    JourEmission INT NOT NULL,
    MontantChambre DECIMAL(10,2) DEFAULT 0.00,
    MontantSoins DECIMAL(10,2) DEFAULT 0.00,
    MontantMedicaments DECIMAL(10,2) DEFAULT 0.00,
    MontantTotal DECIMAL(10,2) DEFAULT 0.00,
    Statut ENUM('Générée', 'Envoyée', 'Payée') DEFAULT 'Générée',
    FOREIGN KEY (IdPatient) REFERENCES Patients_Actifs(IdPatient) ON DELETE CASCADE
);

ALTER TABLE Patients_Actifs ADD FOREIGN KEY (IdFacture) REFERENCES Facture(IdFacture) ON DELETE SET NULL;

CREATE TABLE Medicament (
    IdMedicament INT AUTO_INCREMENT PRIMARY KEY,
    Nom VARCHAR(100) NOT NULL,
    DCI VARCHAR(100),
    Forme VARCHAR(50),
    StockActuel INT DEFAULT 0,
    StockMinimum INT DEFAULT 10,
    PrixUnitaire DECIMAL(10,2) NOT NULL,
    IdUnite INT NOT NULL,
    FOREIGN KEY (IdUnite) REFERENCES Unite(IdUnite) ON DELETE CASCADE
);

CREATE TABLE Prescription (
    IdPrescription INT AUTO_INCREMENT PRIMARY KEY,
    IdPatient INT NOT NULL,
    IdMedecin INT NOT NULL,
    IdMedicament INT NOT NULL,
    Quantite INT NOT NULL,
    Posologie VARCHAR(255),
    DatePrescription INT NOT NULL,
    Statut ENUM('En cours', 'Terminée') DEFAULT 'En cours',
    FOREIGN KEY (IdPatient) REFERENCES Patients_Actifs(IdPatient) ON DELETE CASCADE,
    FOREIGN KEY (IdMedecin) REFERENCES Personnel_Actif(IdEmploye) ON DELETE CASCADE,
    FOREIGN KEY (IdMedicament) REFERENCES Medicament(IdMedicament) ON DELETE CASCADE
);

CREATE TABLE LigneFacture (
    IdLigne INT AUTO_INCREMENT PRIMARY KEY,
    IdFacture INT NOT NULL,
    TypePrestation ENUM('Chambre', 'Soin', 'Médicament') NOT NULL,
    Description VARCHAR(255) NOT NULL,
    Quantite INT DEFAULT 1,
    PrixUnitaire DECIMAL(10,2) NOT NULL,
    SousTotal DECIMAL(10,2) NOT NULL,
    FOREIGN KEY (IdFacture) REFERENCES Facture(IdFacture) ON DELETE CASCADE
);

CREATE TABLE Reservation (
    IdReservation INT AUTO_INCREMENT PRIMARY KEY,
    IdPatient INT NOT NULL,
    IdLit INT NOT NULL,
    IdMedecin INT NOT NULL,
    DateEntree INT NOT NULL,
    DateSortie INT,
    Statut ENUM('Active', 'Terminée', 'Annulée') DEFAULT 'Active',
    FOREIGN KEY (IdPatient) REFERENCES Patients_Actifs(IdPatient) ON DELETE CASCADE,
    FOREIGN KEY (IdLit) REFERENCES Lit(IdLit) ON DELETE CASCADE,
    FOREIGN KEY (IdMedecin) REFERENCES Personnel_Actif(IdEmploye) ON DELETE CASCADE
);

CREATE VIEW Helper_HitParade_Medecins AS
SELECT
    med.IdEmploye,
    med.Nom,
    med.Specialite,
    COUNT(r.IdReservation) AS PatientsTraites,
    COALESCE(SUM(CASE WHEN p.Statut = 'Guéri' THEN 1 ELSE 0 END) / NULLIF(COUNT(r.IdReservation), 0) * 100, 0) AS TauxGuerison,
    COALESCE(SUM(f.MontantTotal), 0) AS RevenuGenere
FROM Personnel_Actif med
LEFT JOIN Reservation r ON med.IdEmploye = r.IdMedecin
LEFT JOIN Patients_Actifs p ON r.IdPatient = p.IdPatient
LEFT JOIN Facture f ON p.IdPatient = f.IdPatient
WHERE med.Categorie = 'Corps Médical'
GROUP BY med.IdEmploye, med.Nom, med.Specialite
ORDER BY PatientsTraites DESC;

CREATE VIEW Helper_Etat_Reservations AS
SELECT
    r.IdReservation,
    u.Nom AS Unite,
    c.NumeroChambre,
    l.NumeroLit,
    p.Nom AS Patient,
    med.Nom AS Medecin,
    r.DateEntree,
    r.DateSortie,
    r.Statut
FROM Reservation r
JOIN Lit l ON r.IdLit = l.IdLit
JOIN Chambre c ON l.IdChambre = c.IdChambre
JOIN Unite u ON c.IdUnite = u.IdUnite
JOIN Patients_Actifs p ON r.IdPatient = p.IdPatient
JOIN Personnel_Actif med ON r.IdMedecin = med.IdEmploye;