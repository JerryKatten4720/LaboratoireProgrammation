<Window x:Class="LaboratoireProgrammation.Project.ModernHospital.AddPrescriptionForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une Prescription" Height="300" Width="350"
        WindowStartupLocation="CenterOwner" Background="#2b2d31">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313338"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1e1f22"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Médicament"/>
        <ComboBox x:Name="CbMedicament" DisplayMemberPath="Nom" SelectedValuePath="IdMedicament" Margin="0,5,0,10" Padding="5"/>

        <TextBlock Text="Quantité"/>
        <TextBox x:Name="TbQuantite" Text="1"/>

        <TextBlock Text="Posologie"/>
        <TextBox x:Name="TbPosologie" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

        <Button Content="Prescrire" Click="BtnSave_Click" Height="35" Margin="0,10,0,0" Background="#5865F2" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
    </StackPanel>
</Window>
