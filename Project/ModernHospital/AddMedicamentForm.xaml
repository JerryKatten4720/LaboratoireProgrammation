<Window x:Class="LaboratoireProgrammation.Project.ModernHospital.AddMedicamentForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un Médicament" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" Background="#121212" ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentTeal" Color="#00d4aa" />
        <SolidColorBrush x:Key="AccentTealDim" Color="#00a882" />
        <SolidColorBrush x:Key="TextPrimary" Color="#f0f0f5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8888aa" />
        <SolidColorBrush x:Key="Border" Color="#2a2a38" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1c1c22"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1c1c22" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Padding" Value="5,2" />
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentTeal}" />
            <Setter Property="Foreground" Value="#0d0d0f" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="INFORMATIONS DE BASE" Foreground="{StaticResource AccentTeal}" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Nom du médicament"/>
                    <TextBox x:Name="TbNom"/>

                    <TextBlock Text="DCI"/>
                    <TextBox x:Name="TbDci"/>

                    <TextBlock Text="Forme (ex: Comprimé, IV)"/>
                    <TextBox x:Name="TbForme"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Stock Actuel"/>
                            <TextBox x:Name="TbStockActuel"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Stock Minimum"/>
                            <TextBox x:Name="TbStockMinimum"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Prix Unitaire (Patient)"/>
                            <TextBox x:Name="TbPrix"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Unité"/>
                            <ComboBox x:Name="CbUnite" DisplayMemberPath="Nom" SelectedValuePath="IdUnite" />
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="Temps de livraison moyen (min in-game)"/>
                    <TextBox x:Name="TbTempsLivraison" Text="120"/>
                </StackPanel>
            </ScrollViewer>
            
            <Grid Grid.Column="1" Margin="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="MALADIES SOIGNÉES / CIBLES" Foreground="{StaticResource AccentTeal}" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Sélectionner Maladie"/>
                    <ComboBox x:Name="CbMaladieCible" DisplayMemberPath="Maladie" SelectedValuePath="IdCas"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Bonus Rémission (%)"/>
                            <TextBox x:Name="TbBonusRemission" Text="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Qté à Prescrire"/>
                            <TextBox x:Name="TbQuantitePrescription" Text="1"/>
                        </StackPanel>
                    </Grid>
                    
                    <Button Content="Ajouter Cible" Click="BtnAddCible_Click" Style="{StaticResource ActionBtn}" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>
                </StackPanel>
                
                <Border Grid.Row="2" Background="#1c1c22" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <ListView x:Name="LvCibles" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4" Width="260">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding MaladieNom}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Bonus, StringFormat='Bonus: +\{0\}%'}" Foreground="{StaticResource AccentTeal}"/>
                                        <TextBlock Text="{Binding Quantite, StringFormat='Qté: \{0\}'}" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" Click="BtnRemoveCible_Click" Background="Transparent" Foreground="#FF4D6A" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
            
            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="MALADIES INCOMPATIBLES / ADVERSES" Foreground="#FF4D6A" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Sélectionner Maladie"/>
                    <ComboBox x:Name="CbMaladieIncompatible" DisplayMemberPath="Maladie" SelectedValuePath="IdCas"/>
                    
                    <TextBlock Text="Malus Rémission (%)"/>
                    <TextBox x:Name="TbMalusRemission" Text="10"/>
                    
                    <Button Content="Ajouter Incompatibilité" Click="BtnAddIncompatible_Click" Style="{StaticResource ActionBtn}" Background="#FF4D6A" Foreground="White" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>
                </StackPanel>
                
                <Border Grid.Row="2" Background="#1c1c22" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <ListView x:Name="LvIncompatibles" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4" Width="260">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding MaladieNom}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Malus, StringFormat='Malus: -\{0\}%'}" Foreground="#FF4D6A"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" Click="BtnRemoveIncompatible_Click" Background="Transparent" Foreground="#FF4D6A" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Grid>
        
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="⚡ Génération Auto" Click="BtnAutoGenerate_Click" Height="36" Background="#7c3aed" Foreground="#f0f0f5" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="3" Content="Enregistrer le Médicament" Click="BtnSave_Click" Height="36" Background="{StaticResource AccentTeal}" Foreground="#0d0d0f" BorderThickness="0" FontWeight="Bold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
