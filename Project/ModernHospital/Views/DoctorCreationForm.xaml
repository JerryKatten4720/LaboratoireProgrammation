<Window x:Class="LaboratoireProgrammation.Project.ModernHospital.DoctorCreationForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Créer un nouveau médecin" Height="700" Width="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        mc:Ignorable="d"
        x:Name="RootComponent"
        Background="#121212">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentTeal" Color="#00d4aa" />
        <SolidColorBrush x:Key="AccentTealDim" Color="#00a882" />
        <SolidColorBrush x:Key="TextPrimary" Color="#f0f0f5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8888aa" />
        <SolidColorBrush x:Key="TextDim" Color="#44445a" />
        <SolidColorBrush x:Key="Border" Color="#2a2a38" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1c1c22" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentTeal}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1c1c22" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentTeal}" />
            <Setter Property="Foreground" Value="#0d0d0f" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentTealDim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e1e28" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#121212"
                BorderBrush="{StaticResource AccentTeal}"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                CornerRadius="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="#181818"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Padding="20,16"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0">
                    <StackPanel>
                        <TextBlock Text="👨‍⚕️" FontSize="24" Margin="0,0,0,8" />
                        <TextBlock Text="CRÉER UN NOUVEAU MÉDECIN"
                                   Foreground="{StaticResource AccentTeal}"
                                   FontSize="18"
                                   FontWeight="Black" />
                        <TextBlock Text="Remplissez les informations du personnel médical"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="IDENTITÉ" Foreground="{StaticResource TextDim}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nom" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                           Margin="0,0,0,4" />
                                <TextBox x:Name="TbNom" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Prénom" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                           Margin="0,0,0,4" />
                                <TextBox x:Name="TbPrenom" Text="" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="POSTE" Foreground="{StaticResource TextDim}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,12" />
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Catégorie" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="CbCategorie" SelectionChanged="CbCategorie_SelectionChanged">
                                <ComboBoxItem Content="Corps Médical" />
                                <ComboBoxItem Content="Personnel Soignant" />
                                <ComboBoxItem Content="Personnel Administratif" />
                                <ComboBoxItem Content="Personnel Technique" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Rôle exact" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="CbRole" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Spécialité (optionnel)" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TbSpecialite" Text="" />
                        </StackPanel>

                        <TextBlock Text="COMPÉTENCES // RÉMUNÉRATION" Foreground="{StaticResource TextDim}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,12" />
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Salaire journalier ($)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TbSalaire" Text="0" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="Shift" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="CbShift">
                                <ComboBoxItem Content="Jour" IsSelected="True" />
                                <ComboBoxItem Content="Nuit" />
                                <ComboBoxItem Content="Rotatif" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="24" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Annuler" Style="{StaticResource SecondaryBtn}"
                                Click="BtnCancel_Click" />
                        <Button Grid.Column="2" Content="✓ Créer le médecin" Style="{StaticResource PrimaryBtn}"
                                Click="BtnCreate_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>