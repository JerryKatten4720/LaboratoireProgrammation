<Window x:Class="LaboratoireProgrammation.Project.ModernHospital.PatientActionMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Actions Patient" Height="250" Width="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#f0f0f5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2a2a38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1c1c22" CornerRadius="8" BorderBrush="#2a2a38" BorderThickness="1">
        <StackPanel Margin="4">
            <TextBlock Text="ACTIONS PATIENT" Foreground="#8888aa" FontSize="10" FontWeight="Bold" Margin="12,8,12,4" />

            <Button Style="{StaticResource MenuBtn}" Click="Gueri_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="[ G ]" Margin="0,0,10,0" />
                    <TextBlock Text="Définir comme guéri" Foreground="#00d4aa" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MenuBtn}" Click="Decede_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="[ D ]" Margin="0,0,10,0" />
                    <TextBlock Text="Définir comme décédé" Foreground="#ff4d6a" />
                </StackPanel>
            </Button>

            <Separator Background="#2a2a38" Margin="8,4" />

            <TextBlock Text="SOINS &amp; FINANCES" Foreground="#8888aa" FontSize="10" FontWeight="Bold" Margin="12,4,12,4" />

            <Button Style="{StaticResource MenuBtn}" Click="Prescrire_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋 " Margin="0,0,10,0" />
                    <TextBlock Text="Prescrire un médicament" Foreground="#bbaaff" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MenuBtn}" Click="AssignerMedecin_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🩺 " Margin="0,0,10,0" />
                    <TextBlock Text="Assigner un médecin" Foreground="#bbaaff" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MenuBtn}" Click="Facture_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧾 " Margin="0,0,10,0" />
                    <TextBlock Text="Voir/Générer facture" Foreground="#bbaaff" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MenuBtn}" Click="FraisSupplementaires_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💰 " Margin="0,0,10,0" />
                    <TextBlock Text="Frais supplémentaires" Foreground="#bbaaff" />
                </StackPanel>
            </Button>

            <Separator Background="#2a2a38" Margin="8,4" />

            <TextBlock Text="CHANGER STATUT" Foreground="#8888aa" FontSize="10" FontWeight="Bold" Margin="12,4,12,4" />

            <Button Style="{StaticResource MenuBtn}" Click="Status_Click" Tag="En Diagnostic">

                <TextBlock Text=">>> En Diagnostic" />
            </Button>

            <Button Style="{StaticResource MenuBtn}" Click="Status_Click" Tag="En Traitement">
                <TextBlock Text=">>> En Traitement" />
            </Button>

            <Separator Background="#2a2a38" Margin="8,4" />

            <Button Style="{StaticResource MenuBtn}" Click="Supprimer_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑 " Margin="0,0,10,0" />
                    <TextBlock Text="Supprimer du registre" Foreground="#8888aa" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>