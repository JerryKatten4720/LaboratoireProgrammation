                                        <ComboBox x:Name="CbResLit" DisplayMemberPath="NumeroLit" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0" Width="180">
                                        <TextBlock Text="Médecin" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CbResMedecin" DisplayMemberPath="NomComplet" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0" Width="120">
                                        <TextBlock Text="Classe" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CbResClasse">
                                            <ComboBoxItem Content="Standard" />
                                            <ComboBoxItem Content="VIP" />
                                            <ComboBoxItem Content="Non-assuré" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Content="Réserver" Style="{StaticResource ActionBtn}" VerticalAlignment="Bottom" Margin="0,0,0,0" Click="BtnReserver_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ListView x:Name="LvReservations" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Chambre" DisplayMemberBinding="{Binding Chambre}" Width="80" />
                                        <GridViewColumn Header="Lit" DisplayMemberBinding="{Binding Lit}" Width="80" />
                                        <GridViewColumn Header="Patient" DisplayMemberBinding="{Binding Patient}" Width="150" />
                                        <GridViewColumn Header="Médecin" DisplayMemberBinding="{Binding Medecin}" Width="150" />
                                        <GridViewColumn Header="Entrée" DisplayMemberBinding="{Binding DateEntree}" Width="100" />
                                        <GridViewColumn Header="Durée" DisplayMemberBinding="{Binding DureeSejour}" Width="100" />
                                        <GridViewColumn Header="Statut" DisplayMemberBinding="{Binding Statut}" Width="100" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </Grid>

                    <Grid x:Name="PanelSalleAttente" Visibility="Collapsed" Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Salle d'Attente" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Black" FontSize="28" />
                            <TextBlock Text="Patients en attente de prise en charge" Foreground="{StaticResource TextSecondary}" FontSize="13" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Ratio d'admission : " Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbRatioAdmission" Text="100 %" Foreground="{StaticResource AccentTeal}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="IcSalleAttente">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgCard}" Width="280" Height="200" CornerRadius="12" Margin="0,0,16,16" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding NomComplet}" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Semibold" FontSize="15" />
                                                    <TextBlock Text="{Binding TempsAttenteAffichage}" Foreground="{StaticResource AccentAmber}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1">
                                                    <TextBlock Text="Symptômes observés :" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Symptomes}" Foreground="{StaticResource TextPrimary}" FontSize="12" TextWrapping="Wrap" Height="50" VerticalAlignment="Top" />
                                                </StackPanel>

                                                <Button Grid.Row="2" Content="Admettre le patient" Style="{StaticResource ActionBtn}" HorizontalAlignment="Stretch" Click="BtnAdmettrePatientAttente_Click" Tag="{Binding IdPatientAttente}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="PanelAdmin" Visibility="Collapsed" Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Interface d'Administration" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Black" FontSize="28" />
                            <TextBlock Text="Éditeur de base de données CRUD en temps réel" Foreground="{StaticResource TextSecondary}" FontSize="13" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Sélectionner la Table : " Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbAdminTables" Width="220" Height="34" Background="#1c1c22" Foreground="White" BorderBrush="#2a2a38" Padding="10,0" SelectionChanged="CbAdminTables_SelectionChanged" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Hopital" />
                                <ComboBoxItem Content="Aile" />
                                <ComboBoxItem Content="Departement" />
                                <ComboBoxItem Content="Service" />
                                <ComboBoxItem Content="Unite" />
                                <ComboBoxItem Content="Salle_Attente" />
                                <ComboBoxItem Content="Chambre" />
                                <ComboBoxItem Content="Lit" />
                                <ComboBoxItem Content="Personnel_Actif" />
                                <ComboBoxItem Content="Candidats" />
                                <ComboBoxItem Content="Patients_Actifs" />
                                <ComboBoxItem Content="Salle_Attente_Patients" />
                                <ComboBoxItem Content="Virtual_Queue" />
                                <ComboBoxItem Content="Medicament" />
                                <ComboBoxItem Content="Prescriptions" />
                                <ComboBoxItem Content="Transactions_Financieres" />
                                <ComboBoxItem Content="Reservation" />
                                <ComboBoxItem Content="Facture" />
                                <ComboBoxItem Content="Ligne_Facture" />
                                <ComboBoxItem Content="Cas_Cliniques" />
                            </ComboBox>
                            <Button Content="Rafraîchir" Click="BtnAdminRefresh_Click" Width="100" Height="34" Margin="16,0,0,0" Background="#2a2a38" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Sauvegarder" Click="BtnAdminSave_Click" Width="140" Height="34" Margin="10,0,0,0" Background="#FF4D6A" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Semibold"/>
                        </StackPanel>

                        <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8">
                            <DataGrid x:Name="DgAdminCRUD" Background="Transparent" Foreground="White" RowBackground="#16161c" AlternatingRowBackground="#202028" BorderThickness="0" HorizontalGridLinesBrush="#2a2a38" VerticalGridLinesBrush="#2a2a38" AutoGenerateColumns="True" CanUserAddRows="True" CanUserDeleteRows="True" GridLinesVisibility="All" RowHeaderWidth="20">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#2a2a38"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderBrush" Value="#3a3a4c"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                    <Style TargetType="DataGridRowHeader">
                                        <Setter Property="Background" Value="#16161c"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#2a2a38"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                    <Style x:Key="{x:Static DataGrid.SelectAllCommand}" TargetType="Button">
                                        <Setter Property="Background" Value="#2a2a38"/>
                                        <Setter Property="BorderBrush" Value="#2a2a38"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#2a2a38" BorderBrush="#2a2a38" BorderThickness="0,0,1,1"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#3a3a4c"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <Grid x:Name="PanelProces" Visibility="Collapsed" Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="⚖️ Procès" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Black" FontSize="28" />
                            <TextBlock Text="Suivi des procédures judiciaires initiées suite aux décès de patients" Foreground="{StaticResource TextSecondary}" FontSize="13" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16,14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="EN COURS" Foreground="{StaticResource TextDim}" FontFamily="Segoe UI Semibold" FontSize="10" />
                                    <TextBlock x:Name="TbProcesEnCours" Text="—" Foreground="{StaticResource AccentAmber}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16,14" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="PERDUS" Foreground="{StaticResource TextDim}" FontFamily="Segoe UI Semibold" FontSize="10" />
                                    <TextBlock x:Name="TbProcesLost" Text="—" Foreground="{StaticResource AccentRed}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16,14" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL AMENDES" Foreground="{StaticResource TextDim}" FontFamily="Segoe UI Semibold" FontSize="10" />
                                    <TextBlock x:Name="TbProcesPenalties" Text="— $" Foreground="{StaticResource AccentRed}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8">
                            <ListView x:Name="DgProces">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Patient" Width="160" DisplayMemberBinding="{Binding NomPatient}" />
                                        <GridViewColumn Header="Maladie" Width="160" DisplayMemberBinding="{Binding NomMaladie}" />
                                        <GridViewColumn Header="Taux Rémission" Width="120" DisplayMemberBinding="{Binding TauxRemissionAffichage}" />
                                        <GridViewColumn Header="Jour Ouverture" Width="120" DisplayMemberBinding="{Binding JourOuverture}" />
                                        <GridViewColumn Header="Jugement (Jour)" Width="120" DisplayMemberBinding="{Binding JourFermeture}" />
                                        <GridViewColumn Header="Statut" Width="200" DisplayMemberBinding="{Binding StatutAffichage}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </Grid>

                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#0e0e14" Height="40" Padding="16,2" Margin="0,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TbStatus" Text="✅ Connexion établie" Foreground="{StaticResource AccentTeal}" FontFamily="Consolas" FontSize="12" />
                            <TextBlock DockPanel.Dock="Right" Text="Washington Memorial Safezone : Hospital Sim v1.0" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="DimOverlay" Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="999" />
        </Grid>
        
        
        <ItemsControl x:Name="IcToasts" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,24,0,0" Width="320" Panel.ZIndex="2000">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,10" Background="{Binding BackgroundBrush}" BorderBrush="{StaticResource Border}" BorderThickness="1" SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding Message}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <local:DatabaseError x:Name="DbErrorPanel" 
                             Visibility="Collapsed" 
                             HorizontalAlignment="Center" 
                             VerticalAlignment="Center"
                             Background="#0d0d0f"/>

        
        <Grid x:Name="LoadingPanel" Background="#0d0d0f" Panel.ZIndex="1000" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="800">
                <TextBlock Text="⛨ RUE DE LONDRES MEMORIAL" Foreground="{StaticResource AccentTeal}" FontFamily="Segoe UI Black" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Chargement de la base de données..." Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI" FontSize="28" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,24" />
                <ProgressBar x:Name="PbLoading" Height="8" Background="#1c1c22" Foreground="{StaticResource AccentTeal}" BorderThickness="0" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,12" />
                <TextBlock x:Name="TbLoadingStep" Text="Initialisation..." Foreground="{StaticResource TextSecondary}" FontSize="22" Opacity="0.5" HorizontalAlignment="Center" />
                <TextBlock Text="⚠️ DO NOT CLOSE PROGRAM, IT'S NOT FROZEN ⚠️" Foreground="#781D27" FontFamily="Segoe UI Black" FontSize="32" HorizontalAlignment="Center" Margin="0,100,0,4" Opacity="0.6" />
                <TextBlock Text="IT'S LOADING..." Foreground="#5F1620" FontFamily="Segoe UI Black" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.6" />
            </StackPanel>
        </Grid>
    </Grid>
    
    <Window.Effect>
        <wrappers:CRT x:Name="VaultShader"
                      DistortionStrength="0.0"
                      CurveRadius="0.00"
                      VignetteStrength="0.2"
                      ScanlineIntensity="0.25"
                      ScanlineCount="100.0"
                      ScanlineSpeed="0.00"
                      PixelGridIntensity="0.05"
                      BloomStrength="0.2"
                      ChromaticAberration="0.04"
                      TintColor="#0FFF7F00"
                      Brightness="1.6"
                      Contrast="1.2"
                      NoiseIntensity="0.0125"
                      NoiseScale="0.5"
                      FlickerIntensity="0.06"
                      FlickerSpeed="0.2"
                      PhosphorDecay="0.5"
                      ScreenResolution="1080,720" />
    </Window.Effect>
</Window>