<UserControl x:Class="LaboratoireProgrammation.Project.ViewModels.Laboratoires.OverseerWars.Wastelands"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels1="clr-namespace:LaboratoireProgrammation.Project.ViewModels.Menu"
             mc:Ignorable="d"
             Height="{x:Static viewModels1:MainWindowConfiguration.WastelandGridHeight}"
             Width="{x:Static viewModels1:MainWindowConfiguration.WastelandGridWidth}"
             Background="Transparent" Focusable="True">
    <Grid>

        <Grid x:Name="RootGrid" Background="Transparent" />
        <Canvas x:Name="GameCanvas">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="{Binding CamX}" Y="{Binding CamY}" />
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>
    </Grid>

</UserControl>