<UserControl x:Class="LaboratoireProgrammation.Project.ViewModels.Laboratoires.OverseerWars.OverseerWarsUi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:overseerWars="clr-namespace:LaboratoireProgrammation.Project.ViewModels.Laboratoires.OverseerWars"
             mc:Ignorable="d"
             Background="#0A0806">

    <UserControl.Resources>
        <Style TargetType="ProgressBar" x:Key="ResourceMeter">
            <Setter Property="Height" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#2A241A" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="0" BorderBrush="#1A140D"
                                    BorderThickness="1" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFEFAA" Offset="0" />
                                        <GradientStop
                                            Color="{Binding Foreground.Color, RelativeSource={RelativeSource TemplatedParent}}"
                                            Offset="0.4" />
                                        <GradientStop
                                            Color="{Binding Foreground.Color, RelativeSource={RelativeSource TemplatedParent}}"
                                            Offset="0.8" />
                                        <GradientStop Color="#140D00" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton" x:Key="NavigationTab">
            <Setter Property="Foreground" Value="#6B5D4A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#ubuntu mono" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="28,10,28,10" />
            <Setter Property="GroupName" Value="MainMenu" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="TabBody" Background="Transparent" BorderBrush="#3D342A"
                                    BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}">
                                <Border.Clip>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0,0" IsClosed="True">
                                            <LineSegment Point="1000,0" />
                                            <LineSegment Point="1000,42" />
                                            <LineSegment Point="0,42" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Border.Clip>
                                <TextBlock x:Name="TabLabel" Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="ActiveLine" Height="2" VerticalAlignment="Bottom" Background="Transparent" />
                            <Border x:Name="ScanOverlay" Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,1,4" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#0AFFB70A">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,1,2" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#B8A382" />
                                <Setter TargetName="TabBody" Property="Background" Value="#1A140D" />
                                <Setter TargetName="TabBody" Property="BorderBrush" Value="#6B5D3D" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFB75C" />
                                <Setter TargetName="TabBody" Property="Background" Value="#1F180A" />
                                <Setter TargetName="TabBody" Property="BorderBrush" Value="#FFB75C" />
                                <Setter TargetName="ActiveLine" Property="Background" Value="#FFB75C" />
                                <Setter TargetName="ScanOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Panel.ZIndex="10" BorderThickness="0,0,0,1" Padding="24,14,24,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#16120F" Offset="0" />
                    <GradientStop Color="#0E0B08" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#3A2D1E" />
            </Border.BorderBrush>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="3" Height="18" Fill="#FFB75C" Margin="0,0,6,0" />
                        <Rectangle Width="1" Height="18" Fill="#6B502A" Margin="0,0,8,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="12"
                               Foreground="#6B5D3D" Text="OVERSEER CONTROL TERMINAL  //  RES. MONITOR ACTIVE" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#FFB75C" Margin="0,0,6,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FFB75C" BlurRadius="6" ShadowDepth="0" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="10"
                                   Foreground="#6B5D3D" Text="STATUS | OK" />
                    </StackPanel>
                </Grid>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,14">
                    <Border Margin="0,0,5,6" Padding="12,8,12,8" Background="#14100A" BorderBrush="#3A2D1A"
                            BorderThickness="1" Width="136">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Path Data="M 11,0 L 0,13 L 9,13 L 6,24 L 18,9 L 9,9 Z" Fill="#C8A84B"
                                      Stretch="Uniform" Width="10" Height="13" Margin="0,0,7,0"
                                      VerticalAlignment="Center" />
                                <TextBlock FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                                           VerticalAlignment="Center">
                                    <Run Text="200" Foreground="#C8A84B" FontWeight="Bold" FontSize="20" />
                                    <Run Text=" /450" Foreground="#5C4D3D" FontSize="11" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="ÉNERGIE" FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                                       FontSize="14" Foreground="#4A3D2A" Margin="0,1,0,0" />
                            <ProgressBar Style="{StaticResource ResourceMeter}" Foreground="#C8A84B" Value="200"
                                         Maximum="450" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,5,6" Padding="12,8,12,8" Background="#14100A" BorderBrush="#3A2D1A"
                            BorderThickness="1" Width="136">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Path Data="M 2,10 L 22,10 A 10,10 0 0,0 2,10 Z" Fill="#FFB75C" Stretch="Uniform"
                                      Width="13" Height="10" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                                           VerticalAlignment="Center">
                                    <Run Text="200" Foreground="#FFB75C" FontWeight="Bold" FontSize="20" />
                                    <Run Text=" /450" Foreground="#5C4D3D" FontSize="11" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="RATIONS" FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                                       FontSize="14" Foreground="#4A3D2A" Margin="0,1,0,0" />
                            <ProgressBar Style="{StaticResource ResourceMeter}" Foreground="#FFB75C" Value="200"
                                         Maximum="450" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,5,6" Padding="12,8,12,8" Background="#14100A" BorderBrush="#3A2D1A"
                            BorderThickness="1" Width="136">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Path Data="M 12,2 L 4,14 L 10,14 L 10,22 L 14,22 L 14,14 L 20,14 Z" Fill="#A8522A"
                                      Stretch="Uniform" Width="10" Height="14" Margin="0,0,7,0"
                                      VerticalAlignment="Center" />
                                <TextBlock FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                                           VerticalAlignment="Center">
                                    <Run Text="200" Foreground="#C8724A" FontWeight="Bold" FontSize="20" />
                                    <Run Text=" /450" Foreground="#5C4D3D" FontSize="11" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="BOIS" FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                                       FontSize="14" Foreground="#4A3D2A" Margin="0,1,0,0" />
                            <ProgressBar Style="{StaticResource ResourceMeter}" Foreground="#C8724A" Value="200"
                                         Maximum="450" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,5,6" Padding="12,8,12,8" Background="#14100A" BorderBrush="#3A2D1A"
                            BorderThickness="1" Width="136">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Path Data="M 4,8 L 20,8 L 22,16 L 2,16 Z" Fill="#8C8C7A" Stretch="Uniform" Width="13"
                                      Height="10" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                                           VerticalAlignment="Center">
                                    <Run Text="200" Foreground="#AAAA96" FontWeight="Bold" FontSize="20" />
                                    <Run Text=" /300" Foreground="#5C4D3D" FontSize="11" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="MÉTAUXx" FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                                       FontSize="14" Foreground="#4A3D2A" Margin="0,1,0,0" />
                            <ProgressBar Style="{StaticResource ResourceMeter}" Foreground="#AAAA96" Value="200"
                                         Maximum="300" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,6" Padding="12,8,12,8" Background="#14100A" BorderBrush="#3A2D1A"
                            BorderThickness="1" Width="136">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Path Data="M 12,0 L 15,8 L 24,9 L 17,15 L 19,24 L 12,19 L 5,24 L 7,15 L 0,9 L 9,8 Z"
                                      Fill="#00DDCC" Stretch="Uniform" Width="12" Height="12" Margin="0,0,7,0"
                                      VerticalAlignment="Center" />
                                <TextBlock FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                                           VerticalAlignment="Center">
                                    <Run Text="200" Foreground="#00DDCC" FontWeight="Bold" FontSize="20" />
                                    <Run Text=" /300" Foreground="#5C4D3D" FontSize="11" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="CAPSULES" FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                                       FontSize="14" Foreground="#4A3D2A" Margin="0,1,0,0" />
                            <ProgressBar Style="{StaticResource ResourceMeter}" Foreground="#00DDCC" Value="200"
                                         Maximum="300" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <RadioButton Style="{StaticResource NavigationTab}" Content="ABRI" />
                    <RadioButton Style="{StaticResource NavigationTab}" Content="TERRES DÉSOLÉES" IsChecked="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#0A0806">
            <Border IsHitTestVisible="False" Panel.ZIndex="5" Opacity="0.1">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                        <GradientStop Color="Transparent" Offset="0.5" />
                        <GradientStop Color="#AA0A0806" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Border IsHitTestVisible="False" Panel.ZIndex="4" Opacity="0.04">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,1,3" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#FFB75C">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,2000,1" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <overseerWars:Wastelands Visibility="Visible" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                     Panel.ZIndex="1" />
        </Grid>
    </Grid>

</UserControl>