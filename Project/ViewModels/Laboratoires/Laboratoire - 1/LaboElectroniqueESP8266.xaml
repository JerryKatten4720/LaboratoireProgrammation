<UserControl x:Class="LaboratoireProgrammation.Project.ViewModels.Laboratoires.Laboratoire___1.LaboElectroniqueESP8266"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
             mc:Ignorable="d" Background="Transparent"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TerminalBgBrush" Color="#09090B" />
        <SolidColorBrush x:Key="TerminalBorderBrush" Color="#2A2A2E" />
        <SolidColorBrush x:Key="TerminalPanelBrush" Color="#111113" />

        <Style x:Key="RobcoButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#Doto" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TerminalBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TerminalPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TerminalBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Width" Value="250" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource TerminalBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="0,0,0,1" Padding="20">
            <Grid>
                <TextBlock Text="[ ROB.CO - SENSOR LINK TERMINAL ]" FontFamily="pack://application:,,,/Assets/fonts/#Doto" 
                           FontSize="28" FontWeight="Bold" Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}" 
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="PORT COM :" FontFamily="pack://application:,,,/Assets/fonts/#Doto" 
                               Foreground="White" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CbxPorts" Width="100" Margin="0,0,10,0" FontFamily="pack://application:,,,/Assets/fonts/#Doto"/>
                    <Button x:Name="BtnConnect" Content="CONNECT" Style="{StaticResource RobcoButtonStyle}" Click="BtnConnect_Click" Padding="15,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <Border Style="{StaticResource DataBlockStyle}">
                <StackPanel>
                    <TextBlock Text="[ TEMPÉRATURE ]" FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock x:Name="TxtTemperature" Text="--.- °C" FontFamily="pack://application:,,,/Assets/fonts/#Doto" 
                               Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DataBlockStyle}">
                <StackPanel>
                    <TextBlock Text="[ HUMIDITÉ ]" FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock x:Name="TxtHumidite" Text="--.- %" FontFamily="pack://application:,,,/Assets/fonts/#Doto" 
                               Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DataBlockStyle}">
                <StackPanel>
                    <TextBlock Text="[ LUMINOSITÉ ]" FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock x:Name="TxtLuminosite" Text="---- LUX" FontFamily="pack://application:,,,/Assets/fonts/#Doto" 
                               Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource TerminalPanelBrush}" BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="0,1,0,0" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text=">_ SYSTEM OVERRIDE :" FontFamily="pack://application:,,,/Assets/fonts/#Doto" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="0,0,20,0"/>
                
                <Button Content="LED ON" Tag="a" Style="{StaticResource RobcoButtonStyle}" Click="BtnCommand_Click"/>
                <Button Content="LED OFF" Tag="e" Style="{StaticResource RobcoButtonStyle}" Click="BtnCommand_Click"/>
                <Button Content="ANIMATION 1" Tag="p" Style="{StaticResource RobcoButtonStyle}" Click="BtnCommand_Click"/>
                <Button Content="ANIMATION 2" Tag="m" Style="{StaticResource RobcoButtonStyle}" Click="BtnCommand_Click"/>
                <Button Content="BUZZER ON" Tag="b" Style="{StaticResource RobcoButtonStyle}" Click="BtnCommand_Click"/>
                <Button Content="BUZZER OFF" Tag="s" Style="{StaticResource RobcoButtonStyle}" Click="BtnCommand_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>