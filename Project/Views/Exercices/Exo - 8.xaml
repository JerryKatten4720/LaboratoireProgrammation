<UserControl x:Class="LaboratoireProgrammation.Project.Views.Exercices.Exo___8"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LaboratoireProgrammation.Project.Views.Exercices"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900" Background="#09090B" Loaded="SetupExplorerData">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TerminalYellowBrush" Color="{x:Static colorhelper:ColorHelper.FancyText}" />
        <SolidColorBrush x:Key="TerminalBgBrush" Color="#09090B" />
        <SolidColorBrush x:Key="TerminalPanelBrush" Color="#111113" />
        <SolidColorBrush x:Key="TerminalBorderBrush" Color="#2A2A2E" />
        <FontFamily x:Key="TerminalFont">Consolas</FontFamily>
        
        <Style x:Key="TerminalCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#111113" />
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="BorderBrush" Value="#2A2A2E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MainBorder" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="5,0,0,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextBlock.Foreground="{StaticResource TerminalYellowBrush}"
                                              TextBlock.FontFamily="{StaticResource TerminalFont}"
                                              TextBlock.FontSize="13" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource TerminalYellowBrush}"
                                     BorderThickness="0"
                                     CaretBrush="{StaticResource TerminalYellowBrush}"
                                     FontFamily="{StaticResource TerminalFont}"
                                     FontSize="13"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Focusable="True"
                                     Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" Text="▼"
                                       Foreground="{StaticResource TerminalYellowBrush}"
                                       FontSize="9"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <ToggleButton Grid.ColumnSpan="2"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#111113"
                                        BorderBrush="{StaticResource TerminalYellowBrush}"
                                        BorderThickness="1"
                                        MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource TerminalYellowBrush}" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
                        <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Padding" Value="6,3" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#1F1F10" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#2A2A0A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,4" />
        </Style>

        <Style x:Key="TerminalBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#2A2A2E" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TerminalYellowBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TerminalYellowBrush}" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="TerminalScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3E" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="{StaticResource TerminalYellowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalScrollPageBtn" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalScrollArrowBtn" TargetType="RepeatButton">
            <Setter Property="Background" Value="#111113" />
            <Setter Property="Foreground" Value="#505050" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource TerminalYellowBrush}" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#09090B" />
            <Setter Property="BorderBrush" Value="#2A2A2E" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition MaxHeight="14" />
                                    <RowDefinition Height="0.00001*" />
                                    <RowDefinition MaxHeight="14" />
                                </Grid.RowDefinitions>
                                
                                <RepeatButton Grid.Row="0" Style="{StaticResource TerminalScrollArrowBtn}" Command="ScrollBar.LineUpCommand" Content="▲" FontSize="8" />
                                
                                <Track Grid.Row="1" x:Name="PART_Track" IsDirectionReversed="true">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource TerminalScrollPageBtn}" Command="ScrollBar.PageUpCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource TerminalScrollThumb}" Margin="2,0" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource TerminalScrollPageBtn}" Command="ScrollBar.PageDownCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                                
                                <RepeatButton Grid.Row="2" Style="{StaticResource TerminalScrollArrowBtn}" Command="ScrollBar.LineDownCommand" Content="▼" FontSize="8" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="14" />
                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#0A0A0C" />
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="BorderBrush" Value="#2A2A2E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#0A0A0C" />
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="BorderBrush" Value="#2A2A2E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#111113" />
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="BorderBrush" Value="#2A2A2E" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A2A0A" />
                    <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F1F10" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111113" BorderBrush="#2A2A2E" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" Margin="2,0">
                <Button Style="{StaticResource TerminalBtn}" Content="[ EXIT ]" Click="HandleApplicationExit" />
                <Separator Style="{StaticResource ToolbarSeparatorStyle}" />
                <TextBlock Text="VIEW:" VerticalAlignment="Center" Foreground="#606060" FontFamily="Consolas" Margin="8,0" />
                <ComboBox x:Name="ViewModeSelector" Style="{StaticResource TerminalCombo}" Width="150" SelectionChanged="HandleViewModeChange">
                    <ComboBoxItem Content="Small Icons" />
                    <ComboBoxItem Content="Large Icons" />
                    <ComboBoxItem Content="List" />
                    <ComboBoxItem Content="Details" IsSelected="True" />
                </ComboBox>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="DirectoryTree" Grid.Column="0" SelectedItemChanged="HandleDirectorySelection" TreeViewItem.Expanded="HandleDirectoryExpansion" />

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#111113" />

            <ListView x:Name="FileBrowser" Grid.Column="2" MouseDoubleClick="HandleAssetDoubleClick">
                <ListView.View>
                    <GridView x:Name="FileDetailsView">
                        <GridViewColumn Header="NOM" Width="300" DisplayMemberBinding="{Binding EntityName}" />
                        <GridViewColumn Header="TAIL" Width="100" DisplayMemberBinding="{Binding EntitySize}" />
                        <GridViewColumn Header="CREA" Width="150" DisplayMemberBinding="{Binding CreationDate}" />
                        <GridViewColumn Header="MODI" Width="150" DisplayMemberBinding="{Binding ModificationDate}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Border Grid.Row="2" Background="#111113" BorderBrush="#2A2A2E" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock x:Name="SystemStatusIndicator"
                       Text="[ READY ]"
                       Foreground="#606060"
                       FontFamily="Consolas"
                       FontSize="12"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>