<UserControl x:Class="LaboratoireProgrammation.Project.Views.Exercices.Exo___10"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.expression/blend/2008"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200" Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="TerminalCard" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#Doto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GlowBorder" Margin="-4" Background="Transparent" Opacity="0"
                                    CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="GlowEffect"
                                                      Color="{x:Static colorhelper:ColorHelper.FancyText}"
                                                      ShadowDepth="0" BlurRadius="18" Opacity="0.85" />
                                </Border.Effect>
                            </Border>

                            <Border x:Name="CardBody" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Border x:Name="FillLayer" HorizontalAlignment="Left" Width="0"
                                            Background="{x:Static colorhelper:ColorHelper.FancyTextBrush}"
                                            Opacity="0.15" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FillLayer"
                                                             Storyboard.TargetProperty="Width" To="1200"
                                                             Duration="0:0:0.25" EasingFunction="{x:Null}" />
                                            <DoubleAnimation Storyboard.TargetName="FillLayer"
                                                             Storyboard.TargetProperty="Opacity" To="0.18"
                                                             Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.2" />
                                            <ColorAnimation Storyboard.TargetName="CardBody"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="White" Duration="0:0:0.15" />
                                            <ColorAnimation
                                                Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)"
                                                To="White" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FillLayer"
                                                             Storyboard.TargetProperty="Width" To="0"
                                                             Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="FillLayer"
                                                             Storyboard.TargetProperty="Opacity" To="0.12"
                                                             Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.25" />
                                            <ColorAnimation Storyboard.TargetName="CardBody"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="{x:Static colorhelper:ColorHelper.FancyText}"
                                                            Duration="0:0:0.2" />
                                            <ColorAnimation
                                                Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)"
                                                To="{x:Static colorhelper:ColorHelper.FancyText}" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillLayer" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalCardWarning" TargetType="Button" BasedOn="{StaticResource TerminalCard}">
            <Setter Property="BorderBrush" Value="{x:Static colorhelper:ColorHelper.WarningBrush}" />
            <Setter Property="Foreground" Value="{x:Static colorhelper:ColorHelper.WarningBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
            <Setter Property="BorderBrush" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#ubuntu mono" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="CaretBrush" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
            <Setter Property="Padding" Value="5" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#Doto" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style x:Key="YellowThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{x:Static colorhelper:ColorHelper.WarningBrush}" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="YellowScrollbar" TargetType="ScrollBar">
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource YellowThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text=":// MODULE DE CALCUL NUMÉRIQUE | INTÉGRATION \\"
                           FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="24"
                           Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}" Opacity="0.8" />
                <Rectangle Height="1" Fill="{x:Static colorhelper:ColorHelper.FancyTextBrush}" Opacity="0.2"
                           Margin="0,10,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="10">
                    <Label Content="[ BORNE INFÉRIEURE ]" />
                    <TextBox x:Name="TxtLowerBound" Text="0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10">
                    <Label Content="[ BORNE SUPÉRIEURE ]" />
                    <TextBox x:Name="TxtUpperBound" Text="10" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10">
                    <Label Content="[ SOUS-INTERVALLES (BASE) ]" />
                    <TextBox x:Name="TxtDivisions" Text="1" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="> MÉTHODES STANDARDS"
                               FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="16"
                               Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}" Opacity="0.4"
                               Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnStandardPoly" Content="f(x) = x² + 2" Style="{StaticResource TerminalCard}"
                                Height="45" Click="OnStandardPolyClick" />
                        <Button Grid.Column="1" Content="[?]" Style="{StaticResource TerminalCardWarning}" Width="45"
                                Height="45" Margin="5,0,0,0" Tag="POLY_STD" Click="OnHelpClick" />
                    </Grid>

                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnStandardTrig" Content="f(x) = sin(x)" Style="{StaticResource TerminalCard}"
                                Height="45" Click="OnStandardTrigClick" />
                        <Button Grid.Column="1" Content="[?]" Style="{StaticResource TerminalCardWarning}" Width="45"
                                Height="45" Margin="5,0,0,0" Tag="TRIG_STD" Click="OnHelpClick" />
                    </Grid>

                    <TextBlock Text="> DELEGATES" FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono"
                               FontSize="16" Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}"
                               Opacity="0.4" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnDelegatePoly" Content="[PTR] f(x) = x² + 2"
                                Style="{StaticResource TerminalCard}" Height="45" Click="OnDelegatePolyClick" />
                        <Button Grid.Column="1" Content="[?]" Style="{StaticResource TerminalCardWarning}" Width="45"
                                Height="45" Margin="5,0,0,0" Tag="POLY_PTR" Click="OnHelpClick" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnDelegateTrig" Content="[PTR] f(x) = sin(x)"
                                Style="{StaticResource TerminalCard}" Height="45" Click="OnDelegateTrigClick" />
                        <Button Grid.Column="1" Content="[?]" Style="{StaticResource TerminalCardWarning}" Width="45"
                                Height="45" Margin="5,0,0,0" Tag="TRIG_PTR" Click="OnHelpClick" />
                    </Grid>

                    <TextBlock Text="> MODULES EXPÉRIMENTAUX"
                               FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="16"
                               Foreground="{x:Static colorhelper:ColorHelper.WarningBrush}" Opacity="0.4"
                               Margin="0,20,0,10" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnDelegateExp" Content="[PTR] f(x) = e^x"
                                Style="{StaticResource TerminalCardWarning}" Height="45" Click="OnDelegateExpClick" />
                        <Button Grid.Column="1" Content="[?]" Style="{StaticResource TerminalCardWarning}" Width="45"
                                Height="45" Margin="5,0,0,0" Tag="EXP_PTR" Click="OnHelpClick" />
                    </Grid>

                    <Button x:Name="BtnClearLogs" Content="CLEAR TERMINAL" Style="{StaticResource TerminalCardWarning}"
                            Height="45" Margin="0,15,0,10" Click="OnClearLogsClick" />
                </StackPanel>

                <Border Grid.Column="1" Background="#0A0A0A" Margin="0,0,10,0"
                        BorderBrush="{x:Static colorhelper:ColorHelper.FancyTextBrush}" BorderThickness="1"
                        CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="LbxIntegrationLogs" Background="Transparent" BorderThickness="0"
                                 Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}"
                                 FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="14"
                                 Padding="15">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Margin" Value="0,2" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Background="#0A0A0A" Margin="10,0,0,0"
                        BorderBrush="{x:Static colorhelper:ColorHelper.FancyTextBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="> ANALYSE GRAPHIQUE DES COUCHES AREA" 
                                   FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="14"
                                   Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}" Opacity="0.4" Margin="0,0,0,20"/>
                        <UniformGrid Grid.Row="1" x:Name="GridHistogram" Columns="5" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="OverlayDialog" Background="#E6000000" Visibility="Collapsed">
            <Border Width="600" Height="400" Background="#050505"
                    BorderBrush="{x:Static colorhelper:ColorHelper.WarningBrush}" BorderThickness="2"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="[ DB: ARCHIVES EXPLICATIVES ]"
                               FontFamily="pack://application:,,,/Assets/fonts/#Doto" FontSize="24" FontWeight="Bold"
                               Foreground="{x:Static colorhelper:ColorHelper.WarningBrush}" Margin="0,0,0,15" />
                    <Rectangle Grid.Row="0" Height="1" Fill="{x:Static colorhelper:ColorHelper.WarningBrush}"
                               Opacity="0.3" VerticalAlignment="Bottom" />

                    <ScrollViewer Grid.Row="1" Margin="0,15,0,15">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource YellowScrollbar}" />
                        </ScrollViewer.Resources>
                        <TextBlock x:Name="TxtExplanation"
                                   FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" FontSize="18"
                                   Foreground="{x:Static colorhelper:ColorHelper.WarningBrush}" TextWrapping="Wrap"
                                   LineHeight="26" Margin="0,0,15,0" />
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="[ FERMER ]" Style="{StaticResource TerminalCardWarning}" Height="50"
                            Click="OnCloseDialogClick" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>