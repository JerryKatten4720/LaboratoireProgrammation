<UserControl x:Class="LaboratoireProgrammation.Project.ViewModels.Exercices.Exo3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="auto" d:DesignWidth="auto" Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="FileButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Background" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="10,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Width" Value="400" />
            <Setter Property="Height" Value="60" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.25" />
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#ubuntu mono" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{x:Static colorhelper:ColorHelper.SnowBrush }" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="BorderBrush" Value="WhiteSmoke" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FileButtonStyleON" TargetType="Button">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="WhiteSmoke" />
            <Setter Property="Background" Value="{x:Static colorhelper:ColorHelper.FadeGreenBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Height" Value="60" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="WhiteSmoke" />
                    <Setter Property="BorderBrush" Value="WhiteSmoke" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.Resources>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button x:Name="B1" Grid.Row="0" Grid.Column="0" FontSize="24" Style="{StaticResource FileButtonStyle}"
                Opacity="1" Content="📁 Trier par : " Click="SortFilesClick" />
        <Button Grid.Row="1" Grid.Column="0" FontSize="24" Style="{StaticResource FileButtonStyle}" Opacity="1"
                Content="📁 Nouveau Fichier" Click="NewFileClick" />
        <Button Grid.Row="2" Grid.Column="0" FontSize="24" Style="{StaticResource FileButtonStyle}" Opacity="1"
                Content="📁 Supprimer Fichier" Click="DeleteFileClick" />
        <Button Grid.Row="3" Grid.Column="0" FontSize="24" Style="{StaticResource FileButtonStyle}" Opacity="1"
                Content="📄 Nouvelle Entrée" Click="NewHumanClick" />
        <Button Grid.Row="4" Grid.Column="0" FontSize="24" Style="{StaticResource FileButtonStyle}" Opacity="1"
                Content="📄 Supprimer Entrée" Click="DeleteHumanClick" />

        <ScrollViewer Background="#0FFFB500" Width="400" x:Name="FilesScrollViewer" Margin="10,20,0,0" Grid.Column="0"
                      Grid.Row="5" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                      HorizontalAlignment="Left">
            <StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Label Content="NOMS"  x:Name="NamesLabel"
               HorizontalContentAlignment="Center" 
               FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" Padding="15,5,0,0"
               Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalContentAlignment="Top" FontSize="18" Height="60" Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}"/>
        
        <Label Content="PRÉNOMS"  x:Name="Names2Label"
               HorizontalContentAlignment="Center" 
               FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" Padding="5,5,0,0"
               Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalContentAlignment="Top" FontSize="18" Height="60" Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}"/>

        <Label Content="ENTREPRISE"  x:Name="QualityLabel"
               HorizontalContentAlignment="Center" 
               FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" Padding="5,5,0,0"
               Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" VerticalContentAlignment="Top" FontSize="18" Height="60" Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}"/>

        <Label Content="SALAIRE"  x:Name="SalaryLabel"
               HorizontalContentAlignment="Center" 
               FontFamily="pack://application:,,,/Assets/fonts/#ubuntu mono" Padding="5,5,0,0"
               Grid.Row="0" Grid.Column="4" HorizontalAlignment="Left" VerticalContentAlignment="Top" FontSize="18" Height="60" Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}"/>

        <ScrollViewer Visibility="Hidden" Background="#0FFFB500" Width="200" x:Name="FileContentScrollViewer_Names" ScrollChanged="ScrollViewer_ScrollChanged"
                      Margin="10,-40,0,0" Grid.Column="1" Grid.Row="1" Grid.RowSpan="5"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                      HorizontalAlignment="Left">
            <StackPanel>
            </StackPanel>
        </ScrollViewer>


        <ScrollViewer Visibility="Hidden" Background="#0FFFB500" Width="200" ScrollChanged="ScrollViewer_ScrollChanged"
                      x:Name="FileContentScrollViewer_Names2" Margin="0,-40,0,0" Grid.Column="2"
                      Grid.Row="1" Grid.RowSpan="5" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Left">
            <StackPanel>
            </StackPanel>
        </ScrollViewer>
        
        <ScrollViewer Visibility="Hidden" Background="#0FFFB500" Width="200" ScrollChanged="ScrollViewer_ScrollChanged"
                      x:Name="FileContentScrollViewer_Qualities" Margin="0,-40,0,0" Grid.Column="3"
                      Grid.Row="1" Grid.RowSpan="5" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Left">
            <StackPanel>
            </StackPanel>
        </ScrollViewer>
        
        <ScrollViewer Visibility="Hidden" Background="#0FFFB500" Width="200" ScrollChanged="ScrollViewer_ScrollChanged"
                      x:Name="FileContentScrollViewer_Salary" Margin="0,-40,0,0" Grid.Column="4"
                      Grid.Row="1" Grid.RowSpan="5" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Left">
            <StackPanel>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>