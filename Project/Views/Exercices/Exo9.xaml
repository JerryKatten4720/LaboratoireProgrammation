<UserControl x:Class="LaboratoireProgrammation.Project.Views.Exercices.Exo9"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Height="600" Width="1000">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TerminalTextBrush" Color="#FF8327" />
        <SolidColorBrush x:Key="TerminalDimBrush" Color="#D62C16" />
        <SolidColorBrush x:Key="AlertBrush" Color="#FF0000" />

        <Style x:Key="TerminalText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource TerminalTextBrush}" />
            <Setter Property="Margin" Value="5" />
        </Style>

        <Style x:Key="TerminalButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TerminalTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TerminalTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>

        <StackPanel x:Name="PanelLogin" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="TERMINAL D'URGENCE - ABRI 101" FontSize="28" FontWeight="Bold"
                       Style="{StaticResource TerminalText}" HorizontalAlignment="Center" Margin="0,0,0,30" />
            <TextBlock x:Name="TxtSecurityStatus" Text="Vérification des processus..."
                       Style="{StaticResource TerminalText}" HorizontalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="Grade :" Style="{StaticResource TerminalText}" VerticalAlignment="Center" />
                <TextBox x:Name="InputGrade" Width="150" Background="Transparent"
                         Foreground="{StaticResource TerminalTextBrush}"
                         BorderBrush="{StaticResource TerminalDimBrush}" FontFamily="Consolas" FontSize="16"
                         Padding="5" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20">
                <TextBlock Text="Nom   :" Style="{StaticResource TerminalText}" VerticalAlignment="Center" />
                <TextBox x:Name="InputNom" Width="150" Background="Transparent"
                         Foreground="{StaticResource TerminalTextBrush}"
                         BorderBrush="{StaticResource TerminalDimBrush}" FontFamily="Consolas" FontSize="16"
                         Padding="5" />
            </StackPanel>

            <Button Content="S'AUTHENTIFIER" Style="{StaticResource TerminalButton}" Click="BtnAuthenticate_Click" />
        </StackPanel>

        <Grid x:Name="PanelReactor" Visibility="Hidden" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="CONTRÔLE DES POMPES" FontSize="22" Style="{StaticResource TerminalText}" />
                <Button Content="ACTIVER POMPES (P / S)" Style="{StaticResource TerminalButton}"
                        Click="BtnStartPumps_Click" HorizontalAlignment="Left" />
                <ScrollViewer Height="400" Margin="0,10,20,0" Background="#111113">
                    <TextBlock x:Name="TxtPumpLog" Style="{StaticResource TerminalText}" TextWrapping="Wrap"
                               FontSize="14" Foreground="#A0A0A0" />
                </ScrollViewer>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="RÉGULATION DE PRESSION" FontSize="22" Style="{StaticResource TerminalText}" />

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <RadioButton x:Name="RbNoLock" Content="Aucune Sécurité" Foreground="{StaticResource AlertBrush}"
                                 FontFamily="Consolas" FontSize="16" Margin="0,0,15,0" IsChecked="True" />
                    <RadioButton x:Name="RbLock" Content="Verrou Lock" Foreground="{StaticResource TerminalTextBrush}"
                                 FontFamily="Consolas" FontSize="16" Margin="0,0,15,0" />
                    <RadioButton x:Name="RbRWLock" Content="RWLock" Foreground="{StaticResource TerminalTextBrush}"
                                 FontFamily="Consolas" FontSize="16" Margin="0,0,15,0" />
                    <RadioButton x:Name="RbMutex" Content="Mutex" Foreground="{StaticResource TerminalTextBrush}"
                                 FontFamily="Consolas" FontSize="16" />
                </StackPanel>

                <Button Content="DÉMARRER LA RÉGULATION" Style="{StaticResource TerminalButton}"
                        Click="BtnRegulate_Click" HorizontalAlignment="Left" Margin="0,20,0,0" />

                <TextBlock Text="PRESSION DU COEUR (Cible: 200)" Style="{StaticResource TerminalText}" Margin="0,30,0,0"
                           Foreground="{StaticResource TerminalDimBrush}" />
                <TextBlock x:Name="TxtPressure" Text="000" FontSize="60" FontWeight="Bold"
                           Style="{StaticResource TerminalText}" />
            </StackPanel>
        </Grid>

        <Border x:Name="PopupNotepad" Background="#09090B" BorderBrush="{StaticResource TerminalTextBrush}"
                BorderThickness="2" Width="450" Height="300" Visibility="Hidden" Panel.ZIndex="100">
            <StackPanel Margin="20">
                <TextBlock Text="[ MANUEL DES PROCÉDURES ]" Style="{StaticResource TerminalText}" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock
                    Text="1. Activer les pompes simultanément.&#x0a;2. Choisir un verrou de sécurité.&#x0a;3. Réguler la pression."
                    Style="{StaticResource TerminalText}" Margin="0,20,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="TxtTimer" Text="00:00" Style="{StaticResource TerminalText}"
                           HorizontalAlignment="Center" Margin="0,40,0,0" FontSize="24" />
                <Button Content="COMPRIS !" Style="{StaticResource TerminalButton}" Click="BtnCloseNotepad_Click"
                        Margin="0,30,0,0" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>