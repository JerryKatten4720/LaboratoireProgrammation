<UserControl x:Class="LaboratoireProgrammation.Project.ViewModels.Exercices.Exo2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
             mc:Ignorable="d" Background="Transparent"
             d:DesignHeight="*" d:DesignWidth="*">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" x:Name="Label"
               Content="" Margin="0,0,0,20"
               Background="#1E000000" FontFamily="#alvera" FontSize="12"
               HorizontalAlignment="Stretch" VerticalAlignment="Center" BorderThickness="2"
               BorderBrush="{x:Static colorhelper:ColorHelper.FancyTextBrush}" Padding="30,20,30,20"
               Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}" Visibility="Hidden" />

        <Image x:Name="Folder3" Grid.Row="2" Grid.Column="3" Source="../../../Assets/images/folderYellow.png"
               Width="100" Height="100" />
        <Image x:Name="Folder2" Grid.Row="1" Grid.Column="2" Source="../../../Assets/images/folderYellow.png"
               Width="100" Height="100" />
        <Image x:Name="Folder1" Grid.Row="2" Grid.Column="1" Source="../../../Assets/images/folderYellow.png"
               Width="100" Height="100" />

        <ProgressBar Visibility="Visible" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5" Height="20"
                     Margin="20,40,20,20"
                     BorderThickness="0" Minimum="0" Maximum="100" Background="#1E000000"
                     Foreground="{x:Static colorhelper:ColorHelper.SuccessBrush}"
                     Value="0" IsIndeterminate="false" x:Name="ProgressBar1" />

        <ProgressBar Visibility="Visible" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5" Height="20"
                     Margin="20,10,20,10"
                     BorderThickness="0" Minimum="0" Maximum="100" Background="#1E000000"
                     Foreground="{x:Static colorhelper:ColorHelper.FancyTextBrush}"
                     Value="0" IsIndeterminate="false" x:Name="ProgressBar2" />

        <TextBlock Grid.Row="3" Grid.Column="1" Margin="20,40,20,20"
                   Text="{Binding ElementName=RemainingTrialsBar, Path=Value, StringFormat={}{0:0}%}"
                   HorizontalAlignment="Center" Grid.ColumnSpan="5"
                   VerticalAlignment="Center" />

        <Button x:Name="FilesButton" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" FontSize="36" BorderThickness="3"
                Height="100"
                Margin="10" Width="600" FontWeight="DemiBold"
                Content="Transférer les fichiers" Click="SendFilesClick">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
                    <Setter Property="BorderBrush" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
                    <Setter Property="Background" Value="#1E000000" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>

</UserControl>