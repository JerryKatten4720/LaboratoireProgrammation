<Window x:Class="LaboratoireProgrammation.Project.ViewModels.Menu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wrappers="clr-namespace:LaboratoireProgrammation.Assets.shaders.wrappers"
        xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
        xmlns:exercices="clr-namespace:LaboratoireProgrammation.Project.ViewModels.Exercices"
        xmlns:viewModels1="clr-namespace:LaboratoireProgrammation.Project.ViewModels.Menu"
        xmlns:laboratoire1="clr-namespace:LaboratoireProgrammation.Project.ViewModels.Laboratoires.Laboratoire___1"
        xmlns:memfy="clr-namespace:LaboratoireProgrammation.Project.Views.Miscellaneous.Memfy"
        Title="{x:Static viewModels1:MainWindowConfiguration.Title}"
        Height="{x:Static viewModels1:MainWindowConfiguration.Height}"
        Width="{x:Static viewModels1:MainWindowConfiguration.Width}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#09090B"
        Opacity="{x:Static viewModels1:MainWindowConfiguration.Opacity}"
        Foreground="{x:Static colorhelper:ColorHelper.TextBrush}"
        WindowStyle="None"
        AllowsTransparency="{x:Static viewModels1:MainWindowConfiguration.AllowTransparency}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Terminal Color Palette -->
        <SolidColorBrush x:Key="TerminalYellowBrush" Color="{x:Static colorhelper:ColorHelper.FancyText}" />
        <SolidColorBrush x:Key="TerminalOrangeBrush" Color="{x:Static colorhelper:ColorHelper.HomeText}" />
        <SolidColorBrush x:Key="TerminalGreenBrush" Color="{x:Static colorhelper:ColorHelper.VisualText}" />
        <Color x:Key="TerminalBlack">#000000</Color>
        <SolidColorBrush x:Key="TerminalBlackBrush" Color="{StaticResource TerminalBlack}" />

        <!-- Typography Resources -->
        <FontFamily x:Key="TerminalFont">Consolas</FontFamily>
        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="HeaderFontSize">16</sys:Double>
        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodyFontSize">18</sys:Double>

        <!-- Window Control Button Style -->
        <Style x:Key="RobcoBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="{StaticResource HeaderFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource TerminalYellowBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TerminalBlackBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style (Home)-->
        <Style x:Key="RobcoBtnHome" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TerminalOrangeBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="{StaticResource HeaderFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource TerminalOrangeBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TerminalBlackBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style (Home)-->
        <Style x:Key="RobcoBtnVisualMode" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TerminalGreenBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="{StaticResource HeaderFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource TerminalGreenBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TerminalBlackBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Terminal Text Style -->
        <Style x:Key="TerminalText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="Foreground" Value="{StaticResource TerminalYellowBrush}" />
            <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        </Style>

        <!-- Header Text Style -->
        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource TerminalText}">
            <Setter Property="FontSize" Value="{StaticResource HeaderFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Paragraph Style -->
        <Style TargetType="{x:Type Paragraph}">
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">

        <DockPanel LastChildFill="True" Margin="20">
            <!-- Title Bar -->
            <Grid DockPanel.Dock="Top" Height="40">
                <TextBlock x:Name="TopText" Text="@anto.cldl - Terminal.UI | v1.0"
                           Style="{StaticResource HeaderText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button Style="{StaticResource RobcoBtnHome}" Margin="0,0,20,0"
                            Content="Menu Principal [ 🏠 ]"
                            Click="BackToMenu"
                            WindowChrome.IsHitTestVisibleInChrome="True" />

                    <Button Style="{StaticResource RobcoBtnVisualMode}" Margin="0,0,100,0"
                            Content="Mode Visuel [ ✔ ]" x:Name="VisualMode"
                            Click="BabyModeSwitch"
                            WindowChrome.IsHitTestVisibleInChrome="True" />

                    <Button Style="{StaticResource RobcoBtn}"
                            Content="[ _ ]"
                            Click="MinimizeProgram"
                            WindowChrome.IsHitTestVisibleInChrome="True" />

                    <Button Style="{StaticResource RobcoBtn}"
                            Content="[ □ ]"
                            Click="MaximizeProgram"
                            WindowChrome.IsHitTestVisibleInChrome="True" />

                    <Button Style="{StaticResource RobcoBtn}"
                            Content="[ X ]"
                            Click="CloseProgram"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="Credits" />
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" x:Name="TerminalScroller"
                              Margin="-10">
                    <StackPanel x:Name="TerminalOutputPanel" Margin="10" />
                </ScrollViewer>

                <ScrollViewer Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" CanContentScroll="True"
                              VerticalScrollBarVisibility="Hidden">
                    <RichTextBox x:Name="OutputBox"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TerminalYellowBrush}"
                                 FontFamily="{StaticResource TerminalFont}"
                                 FontSize="{StaticResource BodyFontSize}" IsHitTestVisible="False" />
                </ScrollViewer>

                <exercices:Exo1 Visibility="Collapsed" Panel.ZIndex="0" Grid.Row="0" HorizontalAlignment="Center"
                                VerticalAlignment="Top" Margin="0,100,0,0" x:Name="Exo1" />

                <exercices:Exo1B Visibility="Collapsed" Panel.ZIndex="0" Grid.Row="0" HorizontalAlignment="Center"
                                 VerticalAlignment="Top" Margin="0,400,0,0" x:Name="Exo1B" />
                <laboratoire1:ConnectControl Visibility="Collapsed" Panel.ZIndex="0" Grid.Row="0"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"
                                             x:Name="Labo1B" />

                <exercices:Exo2 Visibility="Collapsed" Panel.ZIndex="0" Grid.Row="0" HorizontalAlignment="Center"
                                VerticalAlignment="Top" Margin="0,100,0,0" x:Name="Exo2" />

                <viewModels1:BabyMode Visibility="Collapsed" Panel.ZIndex="0" Grid.Row="0" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Margin="0,0,0,0" x:Name="BabyMode" />

                <memfy:MemfyAgreement Visibility="Collapsed" Panel.ZIndex="0" Grid.Row="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Margin="0,0,0,100" x:Name="MemfyAgreement" />

                <!-- Input Area -->
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="> "
                               Style="{StaticResource TerminalText}"
                               FontWeight="Bold"
                               FontSize="24"
                               Opacity="0.8"
                               VerticalAlignment="Center" />

                    <TextBox x:Name="InputBox"
                             Panel.ZIndex="99"
                             Grid.Column="1"
                             Background="#40000000"
                             Foreground="{StaticResource TerminalYellowBrush}"
                             BorderThickness="0"
                             Height="24"
                             CaretBrush="{StaticResource TerminalYellowBrush}"
                             FontFamily="{StaticResource TerminalFont}"
                             FontSize="24"
                             PreviewKeyDown="InputBox_PreviewKeyDown"
                             KeyboardNavigation.DirectionalNavigation="None" />
                </Grid>
            </Grid>
        </DockPanel>

    </Grid>

    <Window.Effect>
        <wrappers:CRT x:Name="VaultShader"
                      DistortionStrength="0.2"
                      CurveRadius="0.04"
                      VignetteStrength="0.1"
                      ScanlineIntensity="0.35"
                      ScanlineCount="100.0"
                      ScanlineSpeed="0.02"
                      PixelGridIntensity="0.12"
                      BloomStrength="0.8"
                      ChromaticAberration="0.08"
                      TintColor="#0AFF7D0F"
                      Brightness="0.95"
                      Contrast="0.98"
                      NoiseIntensity="0.02"
                      NoiseScale="0.3"
                      FlickerIntensity="0.06"
                      FlickerSpeed="0.6"
                      PhosphorDecay="0.5"
                      ScreenResolution="1920,1080" />
    </Window.Effect>
</Window>