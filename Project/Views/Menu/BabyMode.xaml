<UserControl x:Class="LaboratoireProgrammation.Project.ViewModels.Menu.BabyMode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Project.Helpers"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="TerminalCard" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{x:Static colorhelper:ColorHelper.FancyTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GlowBorder"
                                    Margin="-4"
                                    Background="Transparent"
                                    Opacity="0"
                                    CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="GlowEffect"
                                                      Color="{x:Static colorhelper:ColorHelper.FancyText}"
                                                      ShadowDepth="0"
                                                      BlurRadius="18"
                                                      Opacity="0.85" />
                                </Border.Effect>
                            </Border>

                            <Border x:Name="CardBody"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Border x:Name="FillLayer"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="{x:Static colorhelper:ColorHelper.FancyTextBrush}"
                                            Opacity="0.15" />
                                    <ContentPresenter />
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Width"
                                                To="1200" Duration="0:0:0.25"
                                                EasingFunction="{x:Null}" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.18" Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="GlowBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.2" />
                                            <ColorAnimation
                                                Storyboard.TargetName="CardBody"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="White" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Width"
                                                To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="FillLayer"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.12" Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="GlowBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.25" />
                                            <ColorAnimation
                                                Storyboard.TargetName="CardBody"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="{x:Static colorhelper:ColorHelper.FancyText}"
                                                Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillLayer" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

