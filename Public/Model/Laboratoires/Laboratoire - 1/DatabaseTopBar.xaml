<UserControl x:Class="LaboratoireProgrammation.Public.Model.Laboratoires.Laboratoire___1.DatabaseTopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Public.Visual_Utils"
             mc:Ignorable="d" Background="Transparent"
             d:DesignHeight="*" d:DesignWidth="*">

    <UserControl.Resources>
        <Style x:Key="ClickableTopBar" TargetType="Button">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="{x:Static colorhelper:ColorUtils.FancyTextBrush}" />
            <Setter Property="Background" Value="{x:Static colorhelper:ColorUtils.FancyTextBrush}" />
            <Setter Property="Opacity" Value="0.9"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="NewTableButton" Grid.Row="0" Grid.Column="0" FontSize="64" BorderThickness="2" Padding="30,20,30,20"
                Margin="5" FontWeight="Bold"
                FontFamily="pack://application:,,,/Assets/fonts/#Doto" Style="{StaticResource ClickableTopBar}"
                Content="Nouvelle Table" Click="NewTable">
        </Button>
        
        <Button x:Name="N" Grid.Row="0" Grid.Column="2" FontSize="64" BorderThickness="2" Padding="30,20,30,20"
                Margin="5" FontWeight="Bold"
                FontFamily="pack://application:,,,/Assets/fonts/#Doto" Style="{StaticResource ClickableTopBar}"
                Content="Nouvelle Table" Click="NewTable">
        </Button>

    </Grid>
</UserControl>