<UserControl x:Class="LaboratoireProgrammation.Public.View.Loader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LaboratoireProgrammation.Public.View"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>

        <Frame x:Name="MainFrame" />

        <Rectangle x:Name="BlackFadeRectangle" Fill="Black" Opacity="0" Panel.ZIndex="11" IsHitTestVisible="False" />

        <Border x:Name="TerminalBorderContainer"
                Panel.ZIndex="5"
                CacheMode="BitmapCache">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" x:Name="TerminalScroller"
                              Margin="-10">
                    <StackPanel x:Name="TerminalOutputPanel" Margin="10" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>