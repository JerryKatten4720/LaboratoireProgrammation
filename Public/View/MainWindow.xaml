<Window x:Class="LaboratoireProgrammation.Public.Model.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wrappers="clr-namespace:LaboratoireProgrammation.Assets.shaders.wrappers"
        xmlns:colorhelper="clr-namespace:LaboratoireProgrammation.Public.Visual_Utils"
        Title="ROBCO TERMINAL" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" 
        Background="#09090B" Foreground="{x:Static colorhelper:ColorUtils.TextBrush}"
        WindowStyle="None" AllowsTransparency="True">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Terminal Color Palette -->
        <SolidColorBrush x:Key="TerminalGreenBrush" Color="{x:Static colorhelper:ColorUtils.FancyText}" />
        <Color x:Key="TerminalBlack">#000000</Color>
        <SolidColorBrush x:Key="TerminalBlackBrush" Color="{StaticResource TerminalBlack}"/>
        
        <!-- Typography Resources -->
        <FontFamily x:Key="TerminalFont">Consolas</FontFamily>
        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="HeaderFontSize">16</sys:Double>
        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodyFontSize">18</sys:Double>
        
        <!-- Window Control Button Style -->
        <Style x:Key="RobcoBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TerminalGreenBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="{StaticResource HeaderFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource TerminalGreenBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TerminalBlackBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Terminal Text Style -->
        <Style x:Key="TerminalText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="Foreground" Value="{StaticResource TerminalGreenBrush}" />
            <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        </Style>
        
        <!-- Header Text Style -->
        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource TerminalText}">
            <Setter Property="FontSize" Value="{StaticResource HeaderFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Paragraph Style -->
        <Style TargetType="{x:Type Paragraph}">
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        
        <DockPanel LastChildFill="True" Margin="20">
            <!-- Title Bar -->
            <Grid DockPanel.Dock="Top" Height="40">
                <TextBlock Text="@anto.cldl - Terminal.UI | v1.0" 
                           Style="{StaticResource HeaderText}"
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource RobcoBtn}" 
                            Content="[ _ ]" 
                            Click="MinimizeProgram" 
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource RobcoBtn}" 
                            Content="[ □ ]" 
                            Click="MaximizeProgram" 
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource RobcoBtn}" 
                            Content="[ X ]" 
                            Click="CloseProgram" 
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock x:Name="Credits"/>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" x:Name="TerminalScroller"
                              Margin="-10">
                    <StackPanel x:Name="TerminalOutputPanel" Margin="10" />
                </ScrollViewer>
                
                <!-- Output Display -->
                <RichTextBox x:Name="OutputBox" 
                             Grid.Row="0" 
                             IsReadOnly="True" 
                             Background="Transparent" 
                             BorderThickness="0"
                             Foreground="{StaticResource TerminalGreenBrush}" 
                             FontFamily="{StaticResource TerminalFont}" 
                             FontSize="{StaticResource BodyFontSize}"
                             VerticalScrollBarVisibility="Hidden" 
                             IsHitTestVisible="False">
                </RichTextBox>
                

                <!-- Input Area -->
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="> " 
                               Style="{StaticResource TerminalText}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    
                    <TextBox x:Name="InputBox" 
                             Grid.Column="1" 
                             Background="#40000000" 
                             Foreground="{StaticResource TerminalGreenBrush}" 
                             BorderThickness="0"
                             CaretBrush="{StaticResource TerminalGreenBrush}" 
                             FontFamily="{StaticResource TerminalFont}" 
                             FontSize="{StaticResource BodyFontSize}"
                             PreviewKeyDown="InputBox_PreviewKeyDown"
                             KeyboardNavigation.DirectionalNavigation="None"/>
                </Grid>
            </Grid>
        </DockPanel>
        
    </Grid>
    
    <!-- CRT Screen Effect -->
    <Window.Effect>
        <wrappers:CRT x:Name="VaultShader"
                      DistortionStrength="0.2"   
                      CurveRadius="0.0"           
                      VignetteStrength="0.1"      
                      ScanlineIntensity="0.15"    
                      ScanlineCount="400.0"       
                      ScanlineSpeed="0.02"         
                      PixelGridIntensity="0.1"
                      ChromaticAberration="0.02" 
                      BloomStrength="0.65"        
                      TintColor="Transparent"         
                      Brightness="1.0"
                      Contrast="1.0"
                      NoiseIntensity="0.02"
                      NoiseScale="0.5"
                      FlickerIntensity="0.02"
                      FlickerSpeed="1.0"
                      PhosphorDecay="0.2"
                      ScreenResolution="1920,1080" />
    </Window.Effect>
</Window>
