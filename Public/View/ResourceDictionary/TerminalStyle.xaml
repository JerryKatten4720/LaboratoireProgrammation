<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:visualUtils="clr-namespace:LaboratoireProgrammation.Public.Visual_Utils">
    
    <!-- Terminal Color Palette -->
        <SolidColorBrush x:Key="TerminalGreenBrush" Color="{x:Static visualUtils:ColorUtils.FancyText}" />
        <Color x:Key="TerminalBlack">#000000</Color>
        <SolidColorBrush x:Key="TerminalBlackBrush" Color="{StaticResource TerminalBlack}"/>
        
        <!-- Typography Resources -->
        <FontFamily x:Key="TerminalFont">Consolas</FontFamily>
        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="HeaderFontSize">16</sys:Double>
        <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodyFontSize">18</sys:Double>
        
        <!-- Window Control Button Style -->
        <Style x:Key="RobcoBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TerminalGreenBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="FontSize" Value="{StaticResource HeaderFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource TerminalGreenBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TerminalBlackBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Terminal Text Style -->
        <Style x:Key="TerminalText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
            <Setter Property="Foreground" Value="{StaticResource TerminalGreenBrush}" />
            <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        </Style>
        
        <!-- Header Text Style -->
        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource TerminalText}">
            <Setter Property="FontSize" Value="{StaticResource HeaderFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Paragraph Style -->
        <Style TargetType="{x:Type Paragraph}">
            <Setter Property="Margin" Value="0"/>
        </Style>
    
</ResourceDictionary>