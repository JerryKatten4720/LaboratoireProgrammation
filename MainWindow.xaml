<Window x:Class="LaboratoireProgrammation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Menfoo" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#171a21" Foreground="White"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False">


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <!-- ========================== -->
    <!--        GLOBAL STYLES       -->
    <!-- ========================== -->
    <Window.Resources>

        <!-- Topbar buttons (close, minimize, maximize) -->
        <Style x:Key="TopbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="35" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontWeight" Value="Thin"/>
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button spécifique -->
        <Style x:Key="CloseButton" BasedOn="{StaticResource TopbarButton}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4242" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Generic hover button (minimize, maximize) -->
        <Style x:Key="HoverButton" BasedOn="{StaticResource TopbarButton}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66c0f4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Generic hover button (minimize, maximize) -->
        <Style x:Key="SwitchButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="Opacity" Value="0.05"></Setter>
            <Setter Property="Padding" Value="0, -35, 0, 0"></Setter>
            <Setter Property="Width" Value="100"></Setter>
            <Setter Property="Height" Value="100"></Setter>
            <Setter Property="FontSize" Value="100"></Setter>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Background" Value="Transparent"></Setter> 
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ========================== -->
    <!--         STRUCTURE          -->
    <!-- ========================== -->
    <Grid x:Name="MainGrid">
        
        <Canvas x:Name="DisplayCanvas" IsHitTestVisible="False" />

        <!-- Top bar -->
        <Border Padding="12, 0, 0, 0" Height="40" VerticalAlignment="Top"/>
        <Button Style="{StaticResource CloseButton}" Content="" WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseProgram" />
        <Button Style="{StaticResource HoverButton}" Content="" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,40,0" Click="MaximizeProgram" />
        <Button Style="{StaticResource HoverButton}" Content="" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,80,0" Click="MinimizeProgram" />
        <!-- Top bar -->

        <Button Style="{StaticResource SwitchButton}" Content="" HorizontalAlignment="Left" Margin="0,35,0,0" Click="GamePrevious" />
        <Button Style="{StaticResource SwitchButton}" Content="" HorizontalAlignment="Right"  Margin="0,35,0,0" Click="GameNext"/>
        
        <Image Source="Assets/Steam.png" Opacity="0.05"></Image>
        
    </Grid>
</Window>